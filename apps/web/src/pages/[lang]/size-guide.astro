---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Locale, LOCALES, t, localePath } from "@/lib/i18n";
import { getSiteSettings } from "@/lib/queries";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const siteSettings = await getSiteSettings();
const contactEmail = siteSettings?.contact?.email ?? "info@bosfoot.com";

const pageTitle = t("sizeGuide.title", locale);
const pageLead = t("sizeGuide.lead", locale);

const steps = [
  {
    title: t("sizeGuide.step1.title", locale),
    body: t("sizeGuide.step1.body", locale),
    image: "/images/sizing/freet-fit.webp",
    imageAlt: "Fit guide — small, true, large sizing diagram",
  },
  {
    title: t("sizeGuide.step2.title", locale),
    body: t("sizeGuide.step2.body", locale),
    image: "/images/sizing/measure-foot-top.webp",
    imageAlt: "Top view — foot on paper against wall",
  },
  {
    title: t("sizeGuide.step3.title", locale),
    body: t("sizeGuide.step3.body", locale),
    image: "/images/sizing/measure-foot-side.webp",
    imageAlt: "Side view — keeping pencil vertical at 90°",
  },
  {
    title: t("sizeGuide.step4.title", locale),
    body: t("sizeGuide.step4.body", locale),
    image: "/images/sizing/measure-foot-dims.webp",
    imageAlt: "Measuring the foot outline with a ruler",
  },
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageLead}
  siteSettings={siteSettings}
>
  <section class="container-page py-12 md:py-16">
    <header class="max-w-2xl mb-12 md:mb-16">
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">
        {pageTitle}
      </h1>
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed">
        {pageLead}
      </p>
    </header>

    <!-- Steps with images -->
    <ol class="list-none p-0 m-0 flex flex-col gap-0 mb-16">
      {
        steps.map((step, idx) => (
          <li class:list={[
            "grid grid-cols-1 sm:grid-cols-[1fr_200px] gap-6 sm:gap-10 items-start py-10",
            idx !== steps.length - 1 && "border-b border-border-subtle",
          ]}>
            <div>
              <h2 class="text-xl md:text-[1.4rem] font-semibold tracking-tight mb-3">
                {step.title}
              </h2>
              <p class="text-base leading-[1.65] text-muted-foreground m-0">
                {step.body}
              </p>
            </div>
            <div class="bg-secondary rounded-lg overflow-hidden border border-border-subtle flex items-center justify-center">
              <img
                src={step.image}
                alt={step.imageAlt}
                loading="lazy"
                class="w-full h-auto object-contain max-h-52"
              />
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Tip -->
    <div class="bg-background border-l-[3px] border-brand px-6 py-5 rounded-r-md mb-16 max-w-[42rem]">
      <h3 class="text-xs font-semibold uppercase tracking-[0.08em] text-brand m-0 mb-2">
        {t("sizeGuide.tip.title", locale)}
      </h3>
      <p class="text-[0.95rem] leading-[1.55] m-0 text-foreground">
        {t("sizeGuide.tip.body", locale)}
      </p>
    </div>

    <!-- Per-brand charts callout -->
    <div class="border-t border-border-subtle py-12 max-w-[42rem]">
      <h2 class="text-2xl font-semibold tracking-tight mb-3">
        {t("sizeGuide.brands.title", locale)}
      </h2>
      <p class="text-base leading-[1.65] text-muted-foreground mb-4">
        {t("sizeGuide.brands.lead", locale)}
      </p>
      <a
        href={localePath(locale, "brands")}
        class="text-[0.95rem] font-medium text-brand hover:text-brand-hover transition-colors"
      >
        {t("nav.brands", locale)} →
      </a>
    </div>

    <!-- Help callout -->
    <div class="border-t border-border-subtle py-12 max-w-[42rem]">
      <h2 class="text-2xl font-semibold tracking-tight mb-3">
        {t("sizeGuide.help.title", locale)}
      </h2>
      <p class="text-base leading-[1.65] text-muted-foreground mb-4">
        {t("sizeGuide.help.body", locale)}
      </p>
      <a
        href={`mailto:${contactEmail}`}
        class="text-[0.95rem] font-medium text-brand hover:text-brand-hover transition-colors"
      >
        {contactEmail} →
      </a>
    </div>
  </section>
</BaseLayout>
