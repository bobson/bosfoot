---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/astro/Hero.astro";
import WhyBarefoot from "@/components/astro/WhyBarefoot.astro";
import WhyUs from "@/components/astro/WhyUs.astro";
import Articles from "@/components/astro/Articles.astro";
import ProductCard from "@/components/astro/ProductCard.astro";
import Button from "@/components/astro/Button.astro";
import { type Locale, LOCALES, t, localePath, pickLocale } from "@/lib/i18n";
import {
  getSiteSettings,
  getFeaturedProducts,
  getFeaturedArticles,
} from "@/lib/queries";
import { SHOWCASE_BRANDS } from "@/lib/brands-showcase";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const [siteSettings, featured, articles] = await Promise.all([
  getSiteSettings(),
  getFeaturedProducts(),
  getFeaturedArticles(),
]);

const siteName = siteSettings?.siteName ?? "Bosfoot";
const tagline = pickLocale(siteSettings?.tagline, locale) ?? "";
---

<BaseLayout
  locale={locale}
  title={siteName}
  description={tagline}
  siteSettings={siteSettings}
>
  <link slot="head" rel="preload" as="image" href="/images/hero/hero-small.webp" media="(max-width: 767px)" />
  <link slot="head" rel="preload" as="image" href="/images/hero/hero-large.webp" media="(min-width: 768px)" />
  <!-- Hero with tagline and rotating quote card -->
  <Hero locale={locale} siteSettings={siteSettings} />

  <!-- Brand strip — right after hero so visitors immediately see our brands -->
  <section class="py-10 bg-background border-b border-border">
    <div class="container-page">
      <p class="label-caps text-xs text-muted-foreground text-center mb-8">
        {t("section.brands", locale)}
      </p>
      <div class="flex flex-col items-center gap-6">
        {/* Freet — featured, centered, larger */}
        {(() => {
          const freet = SHOWCASE_BRANDS.find((b) => !b.comingSoon);
          if (!freet) return null;
          return (
            <a
              href={localePath(locale, "brands")}
              class="flex flex-col items-center gap-3 bg-[#92be00] rounded-xl px-6 py-4 opacity-85 hover:opacity-100 hover:-translate-y-px transition-all duration-150"
              aria-label={freet.name}
            >
              {freet.logoSrc ? (
                <img
                  src={freet.logoSrc}
                  alt={freet.name}
                  loading="lazy"
                  class="h-12 md:h-14 w-auto object-contain"
                />
              ) : (
                <span class:list={["text-2xl md:text-3xl whitespace-nowrap text-foreground", freet.wordmarkClass ?? "font-semibold tracking-tight"]}>
                  {freet.name}
                </span>
              )}
            </a>
          );
        })()}

        {/* Coming soon brands — one row, wraps on small screens */}
        <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
          {SHOWCASE_BRANDS.filter((b) => b.comingSoon).map((brand) => (
            <div
              class="flex flex-col items-center gap-1.5 rounded-xl px-6 py-4 opacity-40 cursor-default"
              aria-label={brand.name}
            >
              {brand.logoSrc ? (
                <img
                  src={brand.logoSrc}
                  alt={brand.name}
                  loading="lazy"
                  class="h-8 w-auto object-contain grayscale"
                />
              ) : (
                <span class:list={["text-base whitespace-nowrap text-foreground", brand.wordmarkClass ?? "font-semibold tracking-tight"]}>
                  {brand.name}
                </span>
              )}
              <span class="text-[0.6rem] font-semibold uppercase tracking-[0.08em] text-muted-foreground">
                {t("brands.comingSoon", locale)}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured products -->
  {
    featured.length > 0 && (
      <section class="py-20 md:py-24 bg-background">
        <div class="container-page">
          <h2 class="text-[1.75rem] md:text-[2.25rem] font-bold tracking-tight mb-10 text-foreground">
            {t("home.featured.title", locale)}
          </h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-3">
            {featured.slice(0, 3).map((product) => (
              <ProductCard product={product} locale={locale} />
            ))}
          </div>
          <div class="mt-10">
            <Button href={localePath(locale, "products")} variant="brand" size="sm">
              {t("cta.viewAll", locale)} →
            </Button>
          </div>
        </div>
      </section>
    )
  }

  <!-- Why barefoot — 3 principles -->
  <WhyBarefoot locale={locale} />

  <!-- Why Bosfoot -->
  <WhyUs locale={locale} />

  <!-- Articles teaser -->
  <Articles locale={locale} articles={articles} />
</BaseLayout>
