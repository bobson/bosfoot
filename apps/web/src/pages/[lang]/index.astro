---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/astro/Hero.astro";
import WhyBarefoot from "@/components/astro/WhyBarefoot.astro";
import WhyUs from "@/components/astro/WhyUs.astro";
import Articles from "@/components/astro/Articles.astro";
import ProductCard from "@/components/astro/ProductCard.astro";
import { type Locale, LOCALES, t, localePath, pickLocale } from "@/lib/i18n";
import {
  getSiteSettings,
  getFeaturedProducts,
  getFeaturedArticles,
} from "@/lib/queries";
import { SHOWCASE_BRANDS } from "@/lib/brands-showcase";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const [siteSettings, featured, articles] = await Promise.all([
  getSiteSettings(),
  getFeaturedProducts(),
  getFeaturedArticles(),
]);

const siteName = siteSettings?.siteName ?? "Bosfoot";
const tagline = pickLocale(siteSettings?.tagline, locale) ?? "";
---

<BaseLayout
  locale={locale}
  title={siteName}
  description={tagline}
  siteSettings={siteSettings}
>
  <!-- Hero with tagline and rotating quote card -->
  <Hero locale={locale} siteSettings={siteSettings} />

  <!-- Featured products — moved up so visitors see merchandise first -->
  {
    featured.length > 0 && (
      <section class="py-20 md:py-24 bg-background">
        <div class="container-page">
          <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
            <h2 class="text-[1.75rem] md:text-[2.25rem] font-semibold tracking-tight m-0 text-foreground">
              {t("home.featured.title", locale)}
            </h2>
            <a
              href={localePath(locale, "products")}
              class="text-sm text-muted-foreground whitespace-nowrap transition-colors hover:text-brand"
            >
              {t("cta.viewAll", locale)} →
            </a>
          </div>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-4">
            {featured.slice(0, 4).map((product) => (
              <ProductCard product={product} locale={locale} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Why barefoot — 3 principles (sage section breaks up the cream rhythm) -->
  <WhyBarefoot locale={locale} />

  <!-- Brand strip — featured brands as wordmarks/logos -->
  <section class="py-16 bg-background border-y border-border">
    <div class="container-page">
      <h2 class="text-xl font-medium uppercase tracking-widest text-muted-foreground text-center mb-10 m-0">
        {t("section.brands", locale)}
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-7 md:gap-x-16 md:gap-y-8">
        {
          SHOWCASE_BRANDS.map((brand) => (
            <a
              href={localePath(locale, "brands")}
              class="group inline-flex items-center text-foreground opacity-70 transition-all duration-150 hover:opacity-100 hover:-translate-y-px"
              aria-label={brand.name}
            >
              {brand.logoSrc ? (
                <img
                  src={brand.logoSrc}
                  alt={brand.name}
                  loading="lazy"
                  class="h-11 w-auto object-contain grayscale transition-[filter] duration-200 group-hover:grayscale-0"
                />
              ) : (
                <span
                  class:list={[
                    "text-lg md:text-xl whitespace-nowrap text-foreground",
                    brand.wordmarkClass ?? "font-semibold tracking-tight",
                  ]}
                >
                  {brand.name}
                </span>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Bosfoot -->
  <WhyUs locale={locale} />

  <!-- Articles teaser -->
  <Articles locale={locale} articles={articles} />
</BaseLayout>
