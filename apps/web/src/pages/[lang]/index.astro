---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/astro/Hero.astro";
import WhyBarefoot from "@/components/astro/WhyBarefoot.astro";
import WhyUs from "@/components/astro/WhyUs.astro";
import Articles from "@/components/astro/Articles.astro";
import ProductCard from "@/components/astro/ProductCard.astro";
import { type Locale, LOCALES, t, localePath, pickLocale } from "@/lib/i18n";
import {
  getSiteSettings,
  getFeaturedProducts,
  getFeaturedArticles,
} from "@/lib/queries";
import { SHOWCASE_BRANDS } from "@/lib/brands-showcase";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const [siteSettings, featured, articles] = await Promise.all([
  getSiteSettings(),
  getFeaturedProducts(),
  getFeaturedArticles(),
]);

const siteName = siteSettings?.siteName ?? "Bosfoot";
const tagline = pickLocale(siteSettings?.tagline, locale) ?? "";
---

<BaseLayout
  locale={locale}
  title={siteName}
  description={tagline}
  siteSettings={siteSettings}
>
  <!-- Hero with tagline and rotating quote card -->
  <Hero locale={locale} siteSettings={siteSettings} />

  <!-- Featured products — moved up so visitors see merchandise first -->
  {
    featured.length > 0 && (
      <section class="featured-products">
        <div class="container-page">
          <div class="section-header">
            <h2 class="section-title">{t("home.featured.title", locale)}</h2>
            <a href={localePath(locale, "products")} class="section-link">
              {t("cta.viewAll", locale)} →
            </a>
          </div>
          <div class="product-grid">
            {featured.slice(0, 4).map((product) => (
              <ProductCard product={product} locale={locale} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Why barefoot — 3 principles (sage section breaks up the cream rhythm) -->
  <WhyBarefoot locale={locale} />

  <!-- Brand strip — five featured brands as wordmarks/logos -->
  <section class="brand-strip">
    <div class="container-page">
      <h2 class="section-title-center">{t("section.brands", locale)}</h2>
      <div class="brand-row">
        {
          SHOWCASE_BRANDS.map((brand) => (
            <a
              href={localePath(locale, "brands")}
              class="brand-item"
              aria-label={brand.name}
            >
              {brand.logoSrc ? (
                <img
                  src={brand.logoSrc}
                  alt={brand.name}
                  class="brand-logo"
                  loading="lazy"
                />
              ) : (
                <span class="brand-wordmark">{brand.name}</span>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Bosfoot -->
  <WhyUs locale={locale} />

  <!-- Articles teaser -->
  <Articles locale={locale} articles={articles} />
</BaseLayout>

<style>
  /* ── Featured products ─────────────────────────────────── */
  .featured-products {
    padding: 5rem 0;
    background: var(--color-bg-primary);
  }
  @media (min-width: 768px) {
    .featured-products {
      padding: 6rem 0;
    }
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
  }
  @media (min-width: 768px) {
    .section-title {
      font-size: 2.25rem;
    }
  }

  .section-title-center {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-align: center;
    margin: 0 0 2.5rem;
  }

  .section-link {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    white-space: nowrap;
    transition: color 120ms ease;
  }
  .section-link:hover {
    color: var(--color-accent);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1rem;
  }
  @media (min-width: 700px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem 1.5rem;
    }
  }
  @media (min-width: 1000px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── Brand strip ───────────────────────────────────────── */
  .brand-strip {
    padding: 4rem 0;
    background: var(--color-bg-primary);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .brand-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.75rem 3rem;
  }
  @media (min-width: 768px) {
    .brand-row {
      gap: 2rem 4rem;
    }
  }

  .brand-item {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
    opacity: 0.7;
    transition: opacity 150ms ease, transform 150ms ease;
  }
  .brand-item:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .brand-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    transition: filter 200ms ease;
  }
  .brand-item:hover .brand-logo {
    filter: grayscale(0%);
  }

  /* Wordmark fallback — used until real SVG logos are dropped into
     /public/images/brands/. Styled to look like a clean lettermark. */
  .brand-wordmark {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .brand-wordmark {
      font-size: 1.25rem;
    }
  }
</style>
