---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CheckoutForm from "@/components/react/CheckoutForm.tsx";
import { type Locale, LOCALES, t } from "@/lib/i18n";
import { getSiteSettings } from "@/lib/queries";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const siteSettings = await getSiteSettings();
---

<BaseLayout
  locale={locale}
  title={t("checkout.placeOrder", locale)}
  siteSettings={siteSettings}
>
  <div class="container-page py-12 md:py-16">
    <h1 class="text-3xl font-semibold tracking-tight mb-10">
      {t("checkout.placeOrder", locale)}
    </h1>
    <CheckoutForm locale={locale} client:load />
  </div>
</BaseLayout>
