---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/astro/Card.astro";
import { type Locale, LOCALES, t, localePath } from "@/lib/i18n";
import { getSiteSettings, getAllBrandSlugs } from "@/lib/queries";
import { SHOWCASE_BRANDS } from "@/lib/brands-showcase";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const [siteSettings, liveSlugs] = await Promise.all([
  getSiteSettings(),
  getAllBrandSlugs(),
]);

// Only brands that exist in Sanity get a clickable detail page.
const liveSet = new Set(liveSlugs);

const pageTitle = t("brands.title", locale);
const pageLead = t("brands.lead", locale);
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageLead}
  siteSettings={siteSettings}
>
  <section class="container-page py-12 md:py-16">
    <header class="max-w-2xl mb-12 md:mb-16">
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">
        {pageTitle}
      </h1>
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed">
        {pageLead}
      </p>
    </header>

    <div
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-7 xl:grid-cols-3"
    >
      {
        SHOWCASE_BRANDS.map((brand) => {
          const isLive = liveSet.has(brand.slug);
          const isComingSoon = brand.comingSoon;
          const href = isLive && !isComingSoon
            ? `${localePath(locale, "brands")}/${brand.slug}`
            : undefined;
          return (
            <Card
              as={isLive && !isComingSoon ? "a" : "div"}
              href={href}
              class:list={[
                isComingSoon ? "opacity-55 cursor-default" : "",
                (isLive && !isComingSoon)
                  ? "hover:-translate-y-0.5 hover:shadow-lg transition-transform"
                  : "",
              ]}
            >
              <div
                class:list={[
                  "flex items-center justify-center px-6 py-10 border-b border-border-subtle min-h-[140px]",
                  !isComingSoon ? "bg-[#92be00]" : "bg-sage-bg-soft",
                ]}
              >
                {brand.logoSrc ? (
                  <img
                    src={brand.logoSrc}
                    alt={brand.name}
                    loading="lazy"
                    class:list={[
                      "max-h-16 w-auto object-contain transition",
                      isComingSoon ? "grayscale opacity-85" : "opacity-95",
                    ]}
                  />
                ) : (
                  <span
                    class:list={[
                      "text-2xl text-foreground",
                      brand.wordmarkClass ?? "font-semibold tracking-tight",
                    ]}
                  >
                    {brand.name}
                  </span>
                )}
              </div>

              <div class="flex flex-1 flex-col gap-2 p-6">
                <div class="flex items-center gap-2">
                  <h2 class="text-lg font-semibold tracking-tight">
                    {brand.name}
                  </h2>
                  {isComingSoon && (
                    <span class="text-[0.6rem] font-semibold uppercase tracking-[0.08em] text-muted-foreground border border-border rounded-full px-2 py-px whitespace-nowrap">
                      {t("brands.comingSoon", locale)}
                    </span>
                  )}
                </div>
                <div
                  class="flex items-center gap-1.5 text-[0.8125rem] uppercase tracking-wider text-muted-foreground"
                >
                  <span>{brand.origin}</span>
                  <span aria-hidden="true">·</span>
                  <span>{brand.founded}</span>
                </div>
                <p
                  class="flex-1 text-[0.9rem] leading-relaxed text-muted-foreground mt-1"
                >
                  {brand.tagline[locale]}
                </p>
                <div
                  class="flex items-center justify-end mt-4 pt-4 border-t border-border-subtle text-[0.8125rem]"
                >
                  {!isComingSoon && isLive ? (
                    <span class="font-medium text-brand transition-colors group-hover:text-brand-hover">
                      {t("brands.viewProducts", locale)}
                    </span>
                  ) : null}
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
