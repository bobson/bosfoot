---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Locale, LOCALES, t, localePath } from "@/lib/i18n";
import { getSiteSettings, getAllBrandSlugs } from "@/lib/queries";
import { SHOWCASE_BRANDS } from "@/lib/brands-showcase";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const [siteSettings, liveSlugs] = await Promise.all([
  getSiteSettings(),
  getAllBrandSlugs(),
]);

// Only brands that exist in Sanity get a clickable detail page.
const liveSet = new Set(liveSlugs);

const pageTitle = t("brands.title", locale);
const pageLead = t("brands.lead", locale);
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageLead}
  siteSettings={siteSettings}
>
  <section class="container-page py-12 md:py-16">
    <header class="max-w-2xl mb-12 md:mb-16">
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">
        {pageTitle}
      </h1>
      <p class="text-base md:text-lg text-[var(--color-ink-muted)] leading-relaxed">
        {pageLead}
      </p>
    </header>

    <div class="brand-grid">
      {
        SHOWCASE_BRANDS.map((brand) => {
          const isLive = liveSet.has(brand.slug);
          const href = isLive
            ? `${localePath(locale, "brands")}/${brand.slug}`
            : undefined;
          const Tag = isLive ? "a" : "div";
          return (
            <Tag
              href={href}
              class:list={["brand-card", !isLive && "brand-card-static"]}
            >
              <div class="brand-card-logo">
                {brand.logoSrc ? (
                  <img
                    src={brand.logoSrc}
                    alt={brand.name}
                    loading="lazy"
                  />
                ) : (
                  <span class="brand-card-wordmark">{brand.name}</span>
                )}
              </div>
              <div class="brand-card-body">
                <h2 class="brand-card-title">{brand.name}</h2>
                <div class="brand-card-meta">
                  <span>{brand.origin}</span>
                  <span aria-hidden="true">·</span>
                  <span>{brand.founded}</span>
                </div>
                <p class="brand-card-desc">{brand.tagline[locale]}</p>
                <div class="brand-card-cta">
                  {isLive ? (
                    <span class="brand-card-arrow">
                      {t("brands.viewProducts", locale)}
                    </span>
                  ) : (
                    <span class="brand-card-soon">
                      {t("brands.comingSoon", locale)}
                    </span>
                  )}
                </div>
              </div>
            </Tag>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .brand-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 700px) {
    .brand-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }
  @media (min-width: 1100px) {
    .brand-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 150ms ease, transform 150ms ease,
      box-shadow 150ms ease;
    color: inherit;
  }
  a.brand-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }
  .brand-card-static {
    opacity: 0.92;
  }

  .brand-card-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    background: var(--color-sage-bg-soft);
    border-bottom: 1px solid var(--color-border-subtle);
    min-height: 140px;
  }
  .brand-card-logo img {
    max-height: 64px;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.85;
    transition: filter 200ms ease, opacity 200ms ease;
  }
  a.brand-card:hover .brand-card-logo img {
    filter: grayscale(0%);
    opacity: 1;
  }
  .brand-card-wordmark {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .brand-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    gap: 0.5rem;
  }
  .brand-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin: 0;
  }
  .brand-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .brand-card-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0.25rem 0 0;
    flex: 1;
  }
  .brand-card-cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.8125rem;
  }
  .brand-card-arrow {
    color: var(--color-accent);
    font-weight: 500;
    transition: color 150ms ease;
  }
  a.brand-card:hover .brand-card-arrow {
    color: var(--color-accent-hover);
  }
  .brand-card-soon {
    color: var(--color-sage-ink-soft);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
  }
</style>
