---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/astro/Button.astro";
import { type Locale, LOCALES, t, localePath, pickLocale } from "@/lib/i18n";
import { getSiteSettings, getAllArticles } from "@/lib/queries";
import type { ArticleCard } from "@/lib/queries";

export const prerender = true;

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;

const [siteSettings, articles] = await Promise.all([
  getSiteSettings(),
  getAllArticles(),
]);
const contactEmail = siteSettings?.contact?.email ?? "info@bosfoot.com";

function articleHref(article: ArticleCard): string {
  const slug =
    article.slug[locale]?.current ??
    article.slug.mk?.current ??
    article.slug.en?.current ??
    article._id;
  return `/${locale}/articles/${slug}`;
}

// Map the hub's topic cards to real articles by their (stable) English slug.
const bySlug = new Map(
  articles.map((a) => [a.slug.en?.current ?? "", a] as const),
);

type TopicCard = {
  categoryKey: string;
  enSlug: string;
  accent: boolean;
  icon: string;
};

const topicConfig: TopicCard[] = [
  {
    categoryKey: "footHealth.topic.achilles",
    enSlug: "zero-drop-what-it-changes",
    accent: false,
    icon: `<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 4 L15 17 Q15 24 10 28"/>
      <path d="M15 17 Q20 21 21 28"/>
      <path d="M8 28 L23 28"/>
    </svg>`,
  },
  {
    categoryKey: "footHealth.topic.veins",
    enSlug: "veins-circulation-barefoot-and-blood-flow",
    accent: false,
    icon: `<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M16 4 Q16 10 12 14 Q8 18 10 24 Q11 27 16 28 Q21 27 22 24 Q24 18 20 14 Q16 10 16 4"/>
      <path d="M12 18 Q16 16 20 18"/>
    </svg>`,
  },
  {
    categoryKey: "footHealth.topic.knees",
    enSlug: "knee-and-back-pain-could-your-shoes-be-the-cause",
    accent: false,
    icon: `<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="13" y1="4" x2="13" y2="14"/>
      <circle cx="13" cy="16.5" r="3"/>
      <line x1="13" y1="19" x2="20" y2="28"/>
    </svg>`,
  },
  {
    categoryKey: "footHealth.topic.transition",
    enSlug: "your-first-60-days-in-barefoot-shoes",
    accent: true,
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2"/>
      <line x1="3" y1="9" x2="21" y2="9"/>
      <line x1="8" y1="3" x2="8" y2="6"/>
      <line x1="16" y1="3" x2="16" y2="6"/>
    </svg>`,
  },
];

const topicCards = topicConfig
  .map((c) => ({ ...c, article: bySlug.get(c.enSlug) }))
  .filter((c): c is TopicCard & { article: ArticleCard } => Boolean(c.article));

const signs = [
  t("footHealth.signs.kneePain", locale),
  t("footHealth.signs.heavyLegs", locale),
  t("footHealth.signs.heelPain", locale),
  t("footHealth.signs.flatFeet", locale),
  t("footHealth.signs.varicose", locale),
  t("footHealth.signs.backPain", locale),
  t("footHealth.signs.bentToes", locale),
  t("footHealth.signs.swollenFeet", locale),
  t("footHealth.signs.fatigue", locale),
];

// ── Deeper guide content (below the hub) ──────────────────────
const features = [
  {
    title: t("newToBarefoot.feature1.title", locale),
    body: t("newToBarefoot.feature1.body", locale),
    icon: `<svg width="32" height="32" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <line x1="6" y1="30" x2="3" y2="6"/>
      <line x1="12" y1="30" x2="10" y2="4"/>
      <line x1="18" y1="30" x2="18" y2="3"/>
      <line x1="24" y1="30" x2="26" y2="4"/>
      <line x1="30" y1="30" x2="33" y2="6"/>
    </svg>`,
  },
  {
    title: t("newToBarefoot.feature2.title", locale),
    body: t("newToBarefoot.feature2.body", locale),
    icon: `<svg width="32" height="32" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="22" x2="33" y2="22"/>
      <polyline points="9,16 4,22 9,28"/>
      <polyline points="27,16 32,22 27,28"/>
      <line x1="14" y1="10" x2="22" y2="10" stroke-dasharray="2 2"/>
    </svg>`,
  },
  {
    title: t("newToBarefoot.feature3.title", locale),
    body: t("newToBarefoot.feature3.body", locale),
    icon: `<svg width="32" height="32" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 22 Q 10 14, 18 22 T 33 22"/>
      <line x1="3" y1="28" x2="33" y2="28" stroke-dasharray="2 2" opacity="0.5"/>
    </svg>`,
  },
];

const steps = [
  { title: t("newToBarefoot.transition.week1.title", locale), body: t("newToBarefoot.transition.week1.body", locale) },
  { title: t("newToBarefoot.transition.week3.title", locale), body: t("newToBarefoot.transition.week3.body", locale) },
  { title: t("newToBarefoot.transition.month2.title", locale), body: t("newToBarefoot.transition.month2.body", locale) },
];

const mistakes = [
  { title: t("newToBarefoot.mistake1.title", locale), body: t("newToBarefoot.mistake1.body", locale) },
  { title: t("newToBarefoot.mistake2.title", locale), body: t("newToBarefoot.mistake2.body", locale) },
  { title: t("newToBarefoot.mistake3.title", locale), body: t("newToBarefoot.mistake3.body", locale) },
];

const faqs = [
  { q: t("newToBarefoot.faq.1.q", locale), a: t("newToBarefoot.faq.1.a", locale) },
  { q: t("newToBarefoot.faq.2.q", locale), a: t("newToBarefoot.faq.2.a", locale) },
  { q: t("newToBarefoot.faq.3.q", locale), a: t("newToBarefoot.faq.3.a", locale) },
  { q: t("newToBarefoot.faq.4.q", locale), a: t("newToBarefoot.faq.4.a", locale) },
];
---

<BaseLayout
  locale={locale}
  title={t("footHealth.title", locale)}
  description={t("footHealth.subtitle", locale)}
  siteSettings={siteSettings}
>

  <!-- Hub hero -->
  <section class="bg-background border-b border-border">
    <div class="container-page pt-12 md:pt-16 pb-10">
      <div class="flex items-end justify-between gap-6 flex-wrap">
        <div>
          <p class="label-caps text-xs text-brand mb-3">{t("footHealth.eyebrow", locale)}</p>
          <h1 class="text-3xl md:text-[2.75rem] font-bold tracking-tight leading-[1.1] mb-3">
            {t("footHealth.title", locale)}
          </h1>
          <p class="text-lg text-muted-foreground m-0">
            {t("footHealth.subtitle", locale)}
          </p>
        </div>
        <a
          href={`/${locale}/articles`}
          class="text-sm font-medium text-brand whitespace-nowrap transition-colors hover:text-brand-hover"
        >
          {t("home.articles.viewAll", locale)} →
        </a>
      </div>
    </div>
  </section>

  <!-- Topic cards — wired to real articles -->
  {topicCards.length > 0 && (
    <section class="container-page py-10 md:py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {topicCards.map(({ categoryKey, accent, icon, article }) => (
          <a
            href={articleHref(article)}
            class:list={[
              "group flex flex-col rounded-xl overflow-hidden transition-transform duration-200 hover:-translate-y-0.5",
              accent ? "bg-brand text-white" : "bg-card ring-1 ring-border hover:ring-foreground/25",
            ]}
          >
            <!-- Header block with icon + category -->
            <div
              class:list={[
                "px-6 py-7 flex flex-col gap-8 min-h-[150px]",
                accent ? "" : "bg-[#2a2825] text-white",
              ]}
            >
              <div set:html={icon} />
              <span class:list={[
                "label-caps text-[0.7rem] mt-auto",
                accent ? "text-white/80" : "text-white/65",
              ]}>
                {t(categoryKey, locale)}
              </span>
            </div>
            <!-- Body -->
            <div class:list={["flex flex-1 flex-col gap-2 p-6", accent ? "" : "bg-card"]}>
              <h2 class:list={[
                "text-[1.05rem] font-bold leading-snug tracking-tight",
                accent ? "text-white" : "text-foreground group-hover:text-brand transition-colors",
              ]}>
                {pickLocale(article.title, locale)}
              </h2>
              {pickLocale(article.lead, locale) && (
                <p class:list={[
                  "text-[0.875rem] leading-relaxed flex-1 line-clamp-3",
                  accent ? "text-white/85" : "text-muted-foreground",
                ]}>
                  {pickLocale(article.lead, locale)}
                </p>
              )}
              <span class:list={[
                "text-sm font-medium mt-2",
                accent ? "text-white" : "text-brand",
              ]}>
                {t("home.articles.readMore", locale)} →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Dark CTA banner -->
  <section class="container-page pb-12 md:pb-16">
    <div class="rounded-xl px-7 py-7 md:px-10 md:py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5" style="background:#2a2825">
      <div class="text-white">
        <p class="font-semibold text-lg tracking-tight mb-1">{t("footHealth.cta.title", locale)}</p>
        <p class="text-white/70 text-sm m-0 max-w-lg leading-relaxed">{t("footHealth.cta.body", locale)}</p>
      </div>
      <Button href="#guide" variant="brand" size="sm" class="flex-shrink-0">
        {t("footHealth.cta.button", locale)} →
      </Button>
    </div>
  </section>

  <!-- Symptoms / signs of bad shoes -->
  <section class="bg-secondary border-y border-border">
    <div class="container-page py-16 md:py-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="label-caps text-xs text-brand mb-3">{t("footHealth.signs.eyebrow", locale)}</p>
        <h2 class="text-2xl md:text-[2rem] font-bold tracking-tight">
          {t("footHealth.signs.title", locale)}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-4xl mx-auto">
        {signs.map((sign) => (
          <div class="flex items-center gap-3 bg-background border border-border rounded-lg px-4 py-3.5">
            <span class="flex-shrink-0 w-4 h-4 rounded-full border-[1.5px] border-brand" aria-hidden="true" />
            <span class="text-[0.9375rem]">{sign}</span>
          </div>
        ))}
      </div>

      <div class="text-center mt-10 max-w-2xl mx-auto">
        <p class="text-muted-foreground text-[0.9375rem] mb-3">{t("footHealth.signs.note", locale)}</p>
        <a href="#guide" class="text-sm font-medium text-brand hover:text-brand-hover transition-colors">
          {t("footHealth.signs.link", locale)} →
        </a>
      </div>
    </div>
  </section>

  <!-- ════════ Deeper beginner guide ════════ -->

  <!-- What makes them different — 3 feature cards -->
  <section id="guide" class="container-page py-16 md:py-20 scroll-mt-20">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3">
      {t("newToBarefoot.what.title", locale)}
    </h2>
    <p class="text-muted-foreground mb-10 max-w-2xl leading-relaxed">
      {t("newToBarefoot.what.lead", locale)}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {features.map((f) => (
        <div class="bg-secondary rounded-xl p-7 flex flex-col gap-4">
          <div class="text-brand w-10 h-10 flex items-center justify-center" set:html={f.icon} />
          <h3 class="text-lg font-semibold tracking-tight">{f.title}</h3>
          <p class="text-[0.9375rem] leading-relaxed text-muted-foreground flex-1">{f.body}</p>
        </div>
      ))}
    </div>
    <Button href={localePath(locale, "shoeAnatomy")} variant="secondary" size="sm">
      {t("nav.shoeAnatomy", locale)} →
    </Button>
  </section>

  <!-- Transition guide — numbered timeline -->
  <section class="bg-secondary border-y border-border">
    <div class="container-page py-16 md:py-20">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3">
        {t("newToBarefoot.transition.title", locale)}
      </h2>
      <p class="text-muted-foreground mb-12 max-w-2xl leading-relaxed">
        {t("newToBarefoot.transition.lead", locale)}
      </p>

      <ol class="relative list-none p-0 m-0 flex flex-col gap-0 max-w-2xl">
        {steps.map((step, idx) => (
          <li class="flex gap-6 pb-10 relative">
            {idx < steps.length - 1 && (
              <div class="absolute left-[18px] top-10 bottom-0 w-px bg-border" aria-hidden="true" />
            )}
            <div class="flex-shrink-0 w-9 h-9 rounded-full bg-brand text-white text-sm font-bold flex items-center justify-center z-10">
              {idx + 1}
            </div>
            <div class="pt-1">
              <h3 class="text-[1.1rem] font-semibold tracking-tight mb-2">{step.title}</h3>
              <p class="text-[0.9375rem] leading-relaxed text-muted-foreground">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Common mistakes -->
  <section class="container-page py-16 md:py-20">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-10">
      {t("newToBarefoot.mistakes.title", locale)}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {mistakes.map((m) => (
        <div class="border border-border rounded-xl p-7 flex flex-col gap-3">
          <div class="text-amber-500">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold tracking-tight">{m.title}</h3>
          <p class="text-[0.9rem] leading-relaxed text-muted-foreground">{m.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-secondary border-y border-border">
    <div class="container-page py-16 md:py-20 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-10">
        {t("newToBarefoot.faq.title", locale)}
      </h2>

      <div class="flex flex-col divide-y divide-border">
        {faqs.map((faq) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-base font-semibold tracking-tight select-none">
              {faq.q}
              <svg
                class="flex-shrink-0 w-5 h-5 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted-foreground">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="container-page py-16 md:py-20 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
      {t("newToBarefoot.cta.title", locale)}
    </h2>
    <p class="text-muted-foreground leading-relaxed mb-8 max-w-xl">
      {t("newToBarefoot.cta.body", locale)}
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href={localePath(locale, "products")} variant="brand" size="lg">
        {t("cta.shopNow", locale)} →
      </Button>
      <Button href={`mailto:${contactEmail}`} variant="secondary" size="lg">
        {contactEmail}
      </Button>
    </div>
  </section>

</BaseLayout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
