---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SpecTable from "@/components/astro/SpecTable.astro";
import PortableText from "@/components/astro/PortableText.astro";
import ImageGallery from "@/components/react/ImageGallery.tsx";
import BuyPanel from "@/components/react/BuyPanel.tsx";
import { type Locale, LOCALES, t, pickLocale, localePath } from "@/lib/i18n";
import {
  getSiteSettings,
  getProductBySlug,
  getAllProductSlugs,
} from "@/lib/queries";
import { urlFor } from "@/lib/sanity";
import { productLD, breadcrumbLD } from "@/lib/structured-data";

export const prerender = true;

/**
 * Generate one page per (locale × product slug) at build time.
 * A product can have a different slug per language; we generate them all.
 */
export async function getStaticPaths() {
  const slugSets = await getAllProductSlugs();
  const paths: Array<{ params: { lang: Locale; slug: string } }> = [];
  for (const set of slugSets) {
    for (const lang of LOCALES) {
      const slug = (set as Record<string, string | undefined>)[lang];
      if (slug) paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params;
const locale = lang as Locale;

const [siteSettings, product] = await Promise.all([
  getSiteSettings(),
  getProductBySlug(slug!),
]);

if (!product) {
  return Astro.redirect(`/${locale}/products`);
}

const name = pickLocale(product.name, locale) ?? "Product";

// Description for this locale (Portable Text)
const descriptionBlocks =
  locale === "mk"
    ? product.description_mk
    : locale === "sq"
      ? product.description_sq
      : product.description_en;

// Build the gallery image array — main image first, then additional gallery images
type GalleryImg = { url: string; thumbUrl: string; alt?: string };
const galleryImages: GalleryImg[] = [];
if (product.mainImage) {
  galleryImages.push({
    url: urlFor(product.mainImage).width(1200).quality(85).format("webp").url(),
    thumbUrl: urlFor(product.mainImage)
      .width(160)
      .quality(70)
      .format("webp")
      .url(),
    alt: name,
  });
}
for (const img of product.gallery ?? []) {
  galleryImages.push({
    url: urlFor(img).width(1200).quality(85).format("webp").url(),
    thumbUrl: urlFor(img).width(160).quality(70).format("webp").url(),
    alt: name,
  });
}

// Smaller image URL for the cart drawer thumbnail
const cartThumbnailUrl = product.mainImage
  ? urlFor(product.mainImage)
      .width(160)
      .height(160)
      .quality(75)
      .format("webp")
      .url()
  : undefined;

const ogImage = product.mainImage
  ? urlFor(product.mainImage).width(1200).height(630).format("jpg").url()
  : undefined;

// JSON-LD: Product + breadcrumb chain (Home → Products → Brand → This product).
const siteUrl = Astro.site ?? "https://bosfoot.com";
const pageUrl = Astro.url.pathname;
const productSchema = productLD({
  siteUrl,
  product,
  locale,
  pageUrl,
  imageUrl: ogImage,
});
const breadcrumbSchema = breadcrumbLD({
  siteUrl,
  items: [
    { name: t("nav.products", locale), url: localePath(locale, "products") },
    {
      name: product.brand.name,
      url: `${localePath(locale, "brands")}/${product.brand.slug.current}`,
    },
    { name: name, url: pageUrl },
  ],
});
---

<BaseLayout
  locale={locale}
  title={`${product.brand.name} ${name}`}
  description={pickLocale(product.shortDescription, locale)}
  siteSettings={siteSettings}
  ogImage={ogImage}
  structuredData={[productSchema, breadcrumbSchema]}
>
  <div class="container-page py-8 md:py-12">
    <!-- Demo notice — matches the amber "Demo" pill on product cards so the
         visual language is consistent across grid and detail pages. -->
    <div
      class="mb-6 flex items-center gap-2 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-900 ring-1 ring-amber-200/70"
      role="note"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="shrink-0"
      >
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
      <span>
        <strong class="font-semibold uppercase tracking-wider">Demo</strong>
        <span class="ml-1">
          — images and product details are for design preview only.
        </span>
      </span>
    </div>

    <!-- Breadcrumb -->
    <nav
      class="text-xs text-muted-foreground mb-6 flex items-center gap-2"
      aria-label="Breadcrumb"
    >
      <a href={`/${locale}/`} class="hover:text-foreground transition-colors">
        Home
      </a>
      <span>›</span>
      <a
        href={`/${locale}/products`}
        class="hover:text-foreground transition-colors"
      >
        {t("nav.products", locale)}
      </a>
      <span>›</span>
      <a
        href={`/${locale}/brands/${product.brand.slug.current}`}
        class="hover:text-foreground transition-colors"
      >
        {product.brand.name}
      </a>
      <span>›</span>
      <span class="text-foreground">{name}</span>
    </nav>

    <!-- Main grid: gallery + sticky buy panel -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-16">
      <!-- Gallery -->
      <div class="lg:col-span-7">
        <ImageGallery images={galleryImages} productName={name} client:load />
      </div>

      <!-- Buy panel (sticky on desktop) -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <BuyPanel
            product={product}
            locale={locale}
            mainImageUrl={cartThumbnailUrl}
            client:load
          />
        </div>
      </div>
    </div>

    <!-- Description + Specs side by side on wide screens -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-16 pt-8 border-t border-border-subtle"
    >
      {
        descriptionBlocks && descriptionBlocks.length > 0 && (
          <div class="lg:col-span-7">
            <PortableText blocks={descriptionBlocks} />
          </div>
        )
      }

      {
        product.specs && (
          <div
            class={
              descriptionBlocks && descriptionBlocks.length > 0
                ? "lg:col-span-5"
                : "lg:col-span-12"
            }
          >
            <SpecTable specs={product.specs} locale={locale} />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
