---
import { type Locale, t, pickLocale, localePath } from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale, siteSettings } = Astro.props;
const siteName = siteSettings?.siteName ?? "Bosfoot";
const tagline =
  pickLocale(siteSettings?.tagline, locale) ?? t("footer.tagline", locale);
const contactEmail = siteSettings?.contact?.email ?? "info@bosfoot.com";

// Legal identity line required by MK consumer-protection law: registered
// name + registration (EMBS) + tax number (EDB). Each piece is rendered
// only when filled in via Sanity, joined by a thin separator.
const legalName = siteSettings?.business?.legalName ?? "БОСФУТ ТП - BOSFOOT SP";
const legalParts = [
  legalName,
  siteSettings?.business?.registrationNumber &&
    `ЕМБС ${siteSettings.business.registrationNumber}`,
  siteSettings?.business?.vatNumber &&
    `ЕДБ ${siteSettings.business.vatNumber}`,
].filter(Boolean);

const shopLinks = [
  { route: "products", label: t("cta.viewAll", locale) },
  { route: "brands", label: t("nav.brands", locale) },
  { route: "articles", label: t("home.articles.title", locale) },
] as const;

const helpLinks = [
  { route: "sizeGuide", label: t("nav.sizeGuide", locale) },
  { route: "about", label: t("nav.about", locale) },
  { route: "shipping", label: t("nav.shipping", locale) },
  { route: "returns", label: t("nav.returns", locale) },
] as const;

const legalLinks = [
  { route: "privacy", label: t("nav.privacy", locale) },
  { route: "terms", label: t("nav.terms", locale) },
] as const;

const columnHeading =
  "text-xs font-medium uppercase tracking-wider text-muted-foreground mb-4";
const linkClass =
  "text-foreground transition-colors hover:text-brand";
---

<footer class="mt-24 bg-secondary border-t border-border">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-10 md:gap-12">

      <!-- Brand block -->
      <div class="col-span-2">
        <img src="/images/logo.svg" alt={siteName} class="h-10 w-auto mb-4" />
        <p class="text-sm text-muted-foreground max-w-xs leading-relaxed">
          {tagline}
        </p>
      </div>

      <!-- Shop -->
      <div>
        <h4 class={columnHeading}>{t("nav.products", locale)}</h4>
        <ul class="space-y-2 text-sm">
          {
            shopLinks.map((link) => (
              <li>
                <a href={localePath(locale, link.route)} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Help -->
      <div>
        <h4 class={columnHeading}>{t("about.contact.title", locale)}</h4>
        <ul class="space-y-2 text-sm">
          {
            helpLinks.map((link) => (
              <li>
                <a href={localePath(locale, link.route)} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class={columnHeading}>Contact</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`mailto:${contactEmail}`} class={linkClass}>
              {contactEmail}
            </a>
          </li>
          {
            siteSettings?.contact?.phone && (
              <li>
                <a
                  href={`tel:${siteSettings.contact.phone}`}
                  class={linkClass}
                >
                  {siteSettings.contact.phone}
                </a>
              </li>
            )
          }
          {
            siteSettings?.contact?.city && (
              <li class="text-muted-foreground">{siteSettings.contact.city}</li>
            )
          }
        </ul>

        {
          (siteSettings?.social?.instagram || siteSettings?.social?.facebook) && (
            <div class="flex gap-3 mt-4">
              {siteSettings.social.instagram && (
                <a
                  href={siteSettings.social.instagram}
                  aria-label="Instagram"
                  class={linkClass}
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                </a>
              )}
              {siteSettings.social.facebook && (
                <a
                  href={siteSettings.social.facebook}
                  aria-label="Facebook"
                  class={linkClass}
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                  </svg>
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>

    <!-- Copyright + legal links -->
    <div
      class="mt-12 pt-6 border-t border-border flex flex-col md:flex-row md:items-start md:justify-between gap-4"
    >
      <div class="text-xs text-muted-foreground space-y-1">
        <p>{t("footer.copyright", locale)}</p>
        <p>{legalParts.join(" · ")}</p>
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-muted-foreground">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={localePath(locale, link.route)}
                class="transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
