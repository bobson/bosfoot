---
import { type Locale, t } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="py-20 md:py-24 bg-secondary border-y border-border">
  <div class="container-page">
    <h2
      class="text-[1.75rem] md:text-[2.25rem] font-bold tracking-tight mb-12 md:mb-16 text-center text-foreground"
    >
      {t("home.whyUs.title", locale)}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 max-w-5xl mx-auto">
      <article class="text-left">
        <div class="text-3xl font-light text-brand tracking-wide mb-3">01</div>
        <h3 class="text-[1.0625rem] font-bold tracking-tight mb-2.5 text-foreground">
          {t("home.whyUs.1.title", locale)}
        </h3>
        <p class="text-[0.9375rem] leading-relaxed text-muted-foreground m-0">
          {t("home.whyUs.1.body", locale)}
        </p>
      </article>

      <article class="text-left">
        <div class="text-3xl font-light text-brand tracking-wide mb-3">02</div>
        <h3 class="text-[1.0625rem] font-bold tracking-tight mb-2.5 text-foreground">
          {t("home.whyUs.2.title", locale)}
        </h3>
        <p class="text-[0.9375rem] leading-relaxed text-muted-foreground m-0">
          {t("home.whyUs.2.body", locale)}
        </p>
      </article>

      <article class="text-left">
        <div class="text-3xl font-light text-brand tracking-wide mb-3">03</div>
        <h3 class="text-[1.0625rem] font-bold tracking-tight mb-2.5 text-foreground">
          {t("home.whyUs.3.title", locale)}
        </h3>
        <p class="text-[0.9375rem] leading-relaxed text-muted-foreground m-0">
          {t("home.whyUs.3.body", locale)}
        </p>
      </article>
    </div>
  </div>
</section>
