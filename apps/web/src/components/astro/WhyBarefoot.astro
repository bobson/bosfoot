---
import { type Locale, t } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/**
 * "Why barefoot" — the sage section that breaks up the cream rhythm.
 * Three icon + title + body cards on a `--color-sage-bg` background.
 * No JS. Sage is preserved by the user's brand decision.
 */
---

<section class="py-20 md:py-28 border-y border-border bg-secondary">
  <div class="container-page">
    <header class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-3xl md:text-[2.75rem] font-bold tracking-tight mb-4 text-foreground">
        {t("home.whyBarefoot.title", locale)}
      </h2>
      <p class="text-[1.05rem] leading-relaxed text-muted-foreground m-0">
        {t("home.whyBarefoot.lead", locale)}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 max-w-5xl mx-auto">
      <article class="text-center">
        <div
          class="inline-flex items-center justify-center w-[72px] h-[72px] rounded-full bg-background text-brand mb-6"
        >
          <!-- Toe-splay icon -->
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <line x1="6" y1="30" x2="3" y2="6" />
            <line x1="12" y1="30" x2="10" y2="4" />
            <line x1="18" y1="30" x2="18" y2="3" />
            <line x1="24" y1="30" x2="26" y2="4" />
            <line x1="30" y1="30" x2="33" y2="6" />
          </svg>
        </div>
        <h3 class="text-lg font-bold tracking-tight mb-2 text-foreground">
          {t("home.whyBarefoot.1.title", locale)}
        </h3>
        <p class="text-[0.9375rem] leading-relaxed text-muted-foreground max-w-xs mx-auto m-0">
          {t("home.whyBarefoot.1.body", locale)}
        </p>
      </article>

      <article class="text-center">
        <div
          class="inline-flex items-center justify-center w-[72px] h-[72px] rounded-full bg-background text-brand mb-6"
        >
          <!-- Zero drop icon -->
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="22" x2="33" y2="22" />
            <polyline points="9,16 4,22 9,28" />
            <polyline points="27,16 32,22 27,28" />
            <line x1="14" y1="10" x2="22" y2="10" stroke-dasharray="2 2" />
          </svg>
        </div>
        <h3 class="text-lg font-bold tracking-tight mb-2 text-foreground">
          {t("home.whyBarefoot.2.title", locale)}
        </h3>
        <p class="text-[0.9375rem] leading-relaxed text-muted-foreground max-w-xs mx-auto m-0">
          {t("home.whyBarefoot.2.body", locale)}
        </p>
      </article>

      <article class="text-center">
        <div
          class="inline-flex items-center justify-center w-[72px] h-[72px] rounded-full bg-background text-brand mb-6"
        >
          <!-- Flexible sole icon -->
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 22 Q 10 14, 18 22 T 33 22" />
            <line x1="3" y1="28" x2="33" y2="28" stroke-dasharray="2 2" opacity="0.5" />
          </svg>
        </div>
        <h3 class="text-lg font-bold tracking-tight mb-2 text-foreground">
          {t("home.whyBarefoot.3.title", locale)}
        </h3>
        <p class="text-[0.9375rem] leading-relaxed text-muted-foreground max-w-xs mx-auto m-0">
          {t("home.whyBarefoot.3.body", locale)}
        </p>
      </article>
    </div>
  </div>
</section>
