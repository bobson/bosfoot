---
import {
  type Locale,
  LOCALES,
  LOCALE_SHORT_LABELS,
  localePath,
  switchLocale,
  t,
} from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";
import CartCount from "@/components/react/CartCount.tsx";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale, siteSettings } = Astro.props;
const currentPath = Astro.url.pathname;
const siteName = siteSettings?.siteName ?? "Bosfoot";
---

<header
  class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-primary)] sticky top-0 z-30"
>
  <div
    class="container-page flex items-center justify-between py-3"
  >
    <!-- Logo / wordmark -->
    <a
      href={`/${locale}/`}
      class="flex items-center gap-2"
      aria-label={siteName}
    >
      <img src="/images/logo.svg" alt={siteName} class="h-10 w-40 md:w-auto" />
    </a>

    <!-- Primary nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      <a
        href={localePath(locale, "products")}
        class="text-sm hover:text-[var(--color-accent)] transition-colors"
      >
        {t("nav.products", locale)}
      </a>
      <a
        href={localePath(locale, "brands")}
        class="text-sm hover:text-[var(--color-accent)] transition-colors"
      >
        {t("nav.brands", locale)}
      </a>
      <a
        href={localePath(locale, "sizeGuide")}
        class="text-sm hover:text-[var(--color-accent)] transition-colors"
      >
        {t("nav.sizeGuide", locale)}
      </a>
      <a
        href={localePath(locale, "about")}
        class="text-sm hover:text-[var(--color-accent)] transition-colors"
      >
        {t("nav.about", locale)}
      </a>
    </nav>

    <!-- Right utilities: language switcher + cart -->
    <div class="flex items-center gap-4">
      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-xs" aria-label="Language">
        {
          LOCALES.map((lang, i) => (
            <>
              {i > 0 && <span class="text-[var(--color-ink-subtle)]">·</span>}
              <a
                href={switchLocale(currentPath, lang)}
                class={`px-1 ${
                  lang === locale
                    ? "font-medium text-[var(--color-ink)]"
                    : "text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]"
                }`}
                hreflang={lang}
                aria-current={lang === locale ? "true" : undefined}
              >
                {LOCALE_SHORT_LABELS[lang]}
              </a>
            </>
          ))
        }
      </div>

      <!-- Cart — clickable, opens drawer; updates count reactively -->
      <CartCount locale={locale} client:load />
    </div>
  </div>
</header>
