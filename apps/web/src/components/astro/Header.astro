---
import { type Locale, LOCALES, LOCALE_SHORT_LABELS, localePath, switchLocale, t } from '@/lib/i18n'
import type { SiteSettings } from '@/lib/queries'

interface Props {
  locale: Locale
  siteSettings: SiteSettings | null
}

const { locale, siteSettings } = Astro.props
const currentPath = Astro.url.pathname
const siteName = siteSettings?.siteName ?? 'Bosfoot'
---

<header class="border-b border-border-subtle bg-bg-primary sticky top-0 z-30">
  <div class="container-page flex items-center justify-between h-16">

    <!-- Logo / wordmark -->
    <a href={`/${locale}/`} class="flex items-center gap-2" aria-label={siteName}>
      <span class="text-xl font-semibold tracking-tight">{siteName}</span>
    </a>

    <!-- Primary nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      <a href={localePath(locale, 'products')} class="text-sm hover:text-accent transition-colors">
        {t('nav.products', locale)}
      </a>
      <a href={localePath(locale, 'brands')} class="text-sm hover:text-accent transition-colors">
        {t('nav.brands', locale)}
      </a>
      <a href={localePath(locale, 'sizeGuide')} class="text-sm hover:text-accent transition-colors">
        {t('nav.sizeGuide', locale)}
      </a>
      <a href={localePath(locale, 'about')} class="text-sm hover:text-accent transition-colors">
        {t('nav.about', locale)}
      </a>
    </nav>

    <!-- Right utilities: language switcher + cart -->
    <div class="flex items-center gap-4">

      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-xs" aria-label="Language">
        {LOCALES.map((lang, i) => (
          <>
            {i > 0 && <span class="text-ink-subtle">·</span>}
            <a
              href={switchLocale(currentPath, lang)}
              class={`px-1 ${
                lang === locale
                  ? 'font-medium text-ink'
                  : 'text-ink-muted hover:text-ink'
              }`}
              hreflang={lang}
              aria-current={lang === locale ? 'true' : undefined}
            >
              {LOCALE_SHORT_LABELS[lang]}
            </a>
          </>
        ))}
      </div>

      <!-- Cart link (placeholder; wire up later) -->
      <a
        href={localePath(locale, 'cart')}
        class="text-sm flex items-center gap-1.5 hover:text-accent transition-colors"
        aria-label="Cart"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span class="font-medium hidden sm:inline" id="cart-count">0</span>
      </a>

    </div>
  </div>
</header>
