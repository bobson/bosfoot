---
import {
  type Locale,
  LOCALES,
  LOCALE_SHORT_LABELS,
  localePath,
  switchLocale,
  t,
} from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";
import CartCount from "@/components/react/CartCount.tsx";
import SearchOverlay from "@/components/react/SearchOverlay.tsx";
import MobileNav from "@/components/react/MobileNav.tsx";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale, siteSettings } = Astro.props;
const currentPath = Astro.url.pathname;
const siteName = siteSettings?.siteName ?? "Bosfoot";

const navLinks = [
  { route: "products", label: t("nav.products", locale) },
  { route: "brands", label: t("nav.brands", locale) },
  { route: "sizeGuide", label: t("nav.sizeGuide", locale) },
  { route: "about", label: t("nav.about", locale) },
] as const;

const mobileNavLinks = navLinks.map((l) => ({
  href: localePath(locale, l.route),
  label: l.label,
}));

const localeLinks = LOCALES.map((lang) => ({
  lang,
  href: switchLocale(currentPath, lang),
  label: LOCALE_SHORT_LABELS[lang],
  isActive: lang === locale,
}));
---

<header
  class="sticky top-0 z-30 bg-background border-b border-border"
>
  <div class="container-page flex items-center justify-between py-3 gap-3">
    <!-- LEFT: burger (mobile, inside MobileNav island) + logo -->
    <div class="flex items-center gap-2 md:gap-3">
      <MobileNav
        client:media="(max-width: 767px)"
        navLinks={mobileNavLinks}
        localeLinks={localeLinks}
        logoSrc="/images/logo.svg"
        siteName={siteName}
      />

      <a href={`/${locale}/`} class="flex items-center" aria-label={siteName}>
        <img src="/images/logo.svg" alt={siteName} class="h-9 md:h-10 w-auto" />
      </a>
    </div>

    <!-- CENTER: primary nav (desktop only) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={localePath(locale, link.route)}
            class="text-sm text-foreground transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- RIGHT: search + language switcher + cart -->
    <div class="flex items-center gap-1 md:gap-3">
      <!-- Search button — opens overlay via global event -->
      <button
        type="button"
        class="inline-flex items-center justify-center w-10 h-10 text-foreground transition-colors hover:text-brand outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
        aria-label="Search"
        onclick="window.dispatchEvent(new CustomEvent('search:open'))"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Mobile: native select (no chevron) — native UX, no JS -->
      <select
        class="md:hidden appearance-none bg-transparent border border-border rounded-sm text-foreground text-xs font-medium px-2.5 py-1.5 leading-none text-center cursor-pointer focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-1"
        style="text-align-last: center;"
        aria-label="Language"
        onchange="if(this.value){window.location.href=this.value;}"
      >
        {
          localeLinks.map((opt) => (
            <option value={opt.href} selected={opt.isActive}>
              {opt.label}
            </option>
          ))
        }
      </select>

      <!-- Desktop: inline switcher -->
      <div
        class="hidden md:flex items-center gap-1 text-xs"
        aria-label="Language"
      >
        {
          localeLinks.map((opt, i) => (
            <>
              {i > 0 && <span class="text-ink-subtle">·</span>}
              <a
                href={opt.href}
                class:list={[
                  "px-1 transition-colors",
                  opt.isActive
                    ? "font-medium text-foreground"
                    : "text-muted-foreground hover:text-foreground",
                ]}
                hreflang={opt.lang}
                aria-current={opt.isActive ? "true" : undefined}
              >
                {opt.label}
              </a>
            </>
          ))
        }
      </div>

      <CartCount locale={locale} client:idle transition:persist />
    </div>
  </div>
</header>

<!-- Search overlay — mounted globally, hidden until search:open event fires -->
<SearchOverlay locale={locale} client:idle />
