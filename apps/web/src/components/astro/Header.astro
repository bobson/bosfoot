---
import {
  type Locale,
  LOCALES,
  LOCALE_SHORT_LABELS,
  LOCALE_FLAGS,
  localePath,
  switchLocale,
  t,
} from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";
import CartCount from "@/components/react/CartCount.tsx";
import SearchOverlay from "@/components/react/SearchOverlay.tsx";
import MobileNav from "@/components/react/MobileNav.tsx";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale, siteSettings } = Astro.props;
const currentPath = Astro.url.pathname;
const siteName = siteSettings?.siteName ?? "Bosfoot";

const navLinks = [
  { route: "products", label: t("nav.products", locale) },
  { route: "brands", label: t("nav.brands", locale) },
  { route: "sizeGuide", label: t("nav.sizeGuide", locale) },
  { route: "about", label: t("nav.about", locale) },
] as const;

const mobileNavLinks = navLinks.map((l) => ({
  href: localePath(locale, l.route),
  label: l.label,
}));

const localeLinks = LOCALES.map((lang) => ({
  lang,
  href: switchLocale(currentPath, lang),
  label: LOCALE_SHORT_LABELS[lang],
  flag: LOCALE_FLAGS[lang],
  isActive: lang === locale,
}));

const activeLocale = localeLinks.find((l) => l.isActive)!;
---

<header
  class="sticky top-0 z-30 bg-background border-b border-border"
  transition:persist={`site-header-${locale}`}
>
  <div class="container-page flex items-center justify-between py-3 gap-3">
    <!-- LEFT: burger (mobile, inside MobileNav island) + logo -->
    <div class="flex items-center gap-2 md:gap-3">
      <MobileNav
        client:media="(max-width: 767px)"
        navLinks={mobileNavLinks}
        localeLinks={localeLinks}
        logoSrc="/images/logo.svg"
        siteName={siteName}
      />

      <a href={`/${locale}/`} class="flex items-center" aria-label={siteName}>
        <img src="/images/logo.svg" alt={siteName} class="h-9 md:h-10 w-auto" />
      </a>
    </div>

    <!-- CENTER: primary nav (desktop only) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={localePath(locale, link.route)}
            class="text-sm text-foreground transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- RIGHT: search + language switcher + cart -->
    <div class="flex items-center gap-1 md:gap-3">
      <!-- Search button — opens overlay via global event -->
      <button
        type="button"
        class="inline-flex items-center justify-center w-10 h-10 text-foreground transition-colors hover:text-brand outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
        aria-label="Search"
        onclick="window.dispatchEvent(new CustomEvent('search:open'))"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Mobile: custom dropdown (button + animated panel) -->
      <div class="md:hidden relative" data-lang-switcher>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 border border-border rounded-sm text-foreground text-xs font-medium pl-2 pr-1.5 py-1.5 leading-none cursor-pointer transition-colors hover:bg-secondary outline-none focus-visible:ring-2 focus-visible:ring-ring"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Language"
          data-lang-trigger
        >
          <span class="emoji-font text-sm leading-none" aria-hidden="true">{activeLocale.flag}</span>
          <span class="tracking-wide">{activeLocale.label}</span>
          <svg
            width="10"
            height="10"
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform duration-200 opacity-70"
            data-lang-chevron
            aria-hidden="true"
          >
            <polyline points="3 4.5 6 7.5 9 4.5"></polyline>
          </svg>
        </button>

        <ul
          role="listbox"
          aria-label="Language"
          class="absolute right-0 top-full mt-1.5 min-w-[7rem] origin-top-right bg-popover border border-border rounded-md shadow-lg py-1 z-40 opacity-0 scale-95 -translate-y-1 pointer-events-none transition duration-150 ease-out"
          data-lang-panel
        >
          {
            localeLinks.map((opt) => (
              <li role="none">
                <a
                  href={opt.href}
                  role="option"
                  aria-selected={opt.isActive ? "true" : "false"}
                  hreflang={opt.lang}
                  class:list={[
                    "flex items-center gap-2.5 px-3 py-2 text-xs transition-colors",
                    opt.isActive
                      ? "text-foreground font-semibold bg-secondary"
                      : "text-muted-foreground hover:text-foreground hover:bg-secondary/60",
                  ]}
                >
                  <span class="emoji-font text-base leading-none" aria-hidden="true">
                    {opt.flag}
                  </span>
                  <span class="tracking-wide">{opt.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Desktop: inline switcher — flag stacked over letter -->
      <div
        class="hidden md:flex items-center gap-2"
        aria-label="Language"
      >
        {
          localeLinks.map((opt) => (
            <a
              href={opt.href}
              class:list={[
                "flex flex-col items-center leading-none px-1 py-0.5 rounded-sm transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring",
                opt.isActive
                  ? "text-foreground"
                  : "text-muted-foreground hover:text-foreground",
              ]}
              hreflang={opt.lang}
              aria-current={opt.isActive ? "true" : undefined}
            >
              <span class="emoji-font text-base leading-none" aria-hidden="true">
                {opt.flag}
              </span>
              <span
                class:list={[
                  "text-[10px] mt-0.5 tracking-wide",
                  opt.isActive ? "font-semibold" : "font-medium",
                ]}
              >
                {opt.label}
              </span>
            </a>
          ))
        }
      </div>

      <CartCount locale={locale} client:idle transition:persist />
    </div>
  </div>
</header>

<!-- Search overlay — mounted globally, hidden until search:open event fires -->
<SearchOverlay locale={locale} client:idle />

<script>
  let cleanup: (() => void) | null = null;

  const setup = () => {
    cleanup?.();
    cleanup = null;

    const root = document.querySelector<HTMLElement>("[data-lang-switcher]");
    if (!root) return;
    const trigger = root.querySelector<HTMLButtonElement>("[data-lang-trigger]");
    const panel = root.querySelector<HTMLElement>("[data-lang-panel]");
    const chevron = root.querySelector<SVGElement>("[data-lang-chevron]");
    if (!trigger || !panel || !chevron) return;

    const OPEN = ["opacity-100", "scale-100", "translate-y-0", "pointer-events-auto"];
    const CLOSED = ["opacity-0", "scale-95", "-translate-y-1", "pointer-events-none"];

    const setOpen = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      if (open) {
        panel.classList.remove(...CLOSED);
        panel.classList.add(...OPEN);
        chevron.classList.add("rotate-180");
      } else {
        panel.classList.remove(...OPEN);
        panel.classList.add(...CLOSED);
        chevron.classList.remove("rotate-180");
      }
    };

    const onTrigger = (e: MouseEvent) => {
      e.stopPropagation();
      setOpen(trigger.getAttribute("aria-expanded") !== "true");
    };
    const onDocClick = (e: MouseEvent) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setOpen(false);
        trigger.focus();
      }
    };

    trigger.addEventListener("click", onTrigger);
    document.addEventListener("click", onDocClick);
    document.addEventListener("keydown", onKey);

    cleanup = () => {
      trigger.removeEventListener("click", onTrigger);
      document.removeEventListener("click", onDocClick);
      document.removeEventListener("keydown", onKey);
    };
  };

  document.addEventListener("astro:page-load", setup);
</script>
