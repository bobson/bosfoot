---
import { type Locale, t, pickLocale } from "@/lib/i18n";
import { urlFor } from "@/lib/sanity";
import type { ArticleCard } from "@/lib/queries";

interface Props {
  locale: Locale;
  articles: ArticleCard[];
}

const { locale, articles } = Astro.props;

function articleHref(article: ArticleCard): string {
  const slug =
    article.slug[locale]?.current ??
    article.slug.mk?.current ??
    article.slug.en?.current ??
    article._id;
  return `/${locale}/articles/${slug}`;
}

function formatDate(iso: string | undefined): string {
  if (!iso) return "";
  const date = new Date(iso);
  // Manual locale-deterministic formatting (avoid hydration risk)
  const monthNames: Record<Locale, string[]> = {
    mk: [
      "јан",
      "фев",
      "мар",
      "апр",
      "мај",
      "јун",
      "јул",
      "авг",
      "сеп",
      "окт",
      "ное",
      "дек",
    ],
    sq: [
      "jan",
      "shk",
      "mar",
      "pri",
      "maj",
      "qer",
      "kor",
      "gus",
      "sht",
      "tet",
      "nën",
      "dhj",
    ],
    en: [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ],
  };
  return `${date.getDate()} ${monthNames[locale][date.getMonth()]} ${date.getFullYear()}`;
}
---

{
  articles.length > 0 && (
    <section class="articles">
      <div class="container-page">
        <div class="articles-header">
          <div>
            <h2 class="articles-title">{t("home.articles.title", locale)}</h2>
            <p class="articles-lead">{t("home.articles.lead", locale)}</p>
          </div>
          <a href={`/${locale}/articles`} class="articles-view-all">
            {t("home.articles.viewAll", locale)} →
          </a>
        </div>

        <div class="articles-grid">
          {articles.map((article) => (
            <a href={articleHref(article)} class="article-card">
              {article.coverImage && (
                <div class="article-image-wrap">
                  <img
                    src={urlFor(article.coverImage)
                      .width(800)
                      .height(500)
                      .quality(80)
                      .format("webp")
                      .url()}
                    alt=""
                    loading="lazy"
                    class="article-image"
                  />
                </div>
              )}
              <div class="article-body">
                {article.publishedAt && (
                  <time class="article-date">
                    {formatDate(article.publishedAt)}
                  </time>
                )}
                <h3 class="article-card-title">
                  {pickLocale(article.title, locale)}
                </h3>
                {pickLocale(article.lead, locale) && (
                  <p class="article-card-lead">
                    {pickLocale(article.lead, locale)}
                  </p>
                )}
                <span class="article-read-more">
                  {t("home.articles.readMore", locale)} →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .articles {
    padding: 5rem 0 6rem;
    background: var(--color-bg-primary);
  }

  @media (min-width: 768px) {
    .articles {
      padding: 7rem 0 8rem;
    }
  }

  .articles-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .articles-title {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0 0 0.5rem;
  }

  @media (min-width: 768px) {
    .articles-title {
      font-size: 2.25rem;
    }
  }

  .articles-lead {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    margin: 0;
    max-width: 28rem;
  }

  .articles-view-all {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
    white-space: nowrap;
    transition: color 120ms ease;
  }
  .articles-view-all:hover {
    color: var(--color-accent);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 700px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .article-card {
    display: block;
    transition: transform 200ms ease;
  }
  .article-card:hover {
    transform: translateY(-3px);
  }

  .article-image-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    margin-bottom: 1.25rem;
  }
  .article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }
  .article-card:hover .article-image {
    transform: scale(1.04);
  }

  .article-body {
    padding: 0 0.25rem;
  }

  .article-date {
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin: 0.5rem 0 0.625rem;
    line-height: 1.3;
    transition: color 120ms ease;
  }
  .article-card:hover .article-card-title {
    color: var(--color-accent);
  }

  .article-card-lead {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-read-more {
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 500;
  }
</style>
