---
import TextLink from "@/components/astro/TextLink.astro";
import { type Locale, t, pickLocale } from "@/lib/i18n";
import { urlFor } from "@/lib/sanity";
import type { ArticleCard } from "@/lib/queries";

interface Props {
  locale: Locale;
  articles: ArticleCard[];
}

const { locale, articles } = Astro.props;

function articleHref(article: ArticleCard): string {
  const slug =
    article.slug[locale]?.current ??
    article.slug.mk?.current ??
    article.slug.en?.current ??
    article._id;
  return `/${locale}/articles/${slug}`;
}

function formatDate(iso: string | undefined): string {
  if (!iso) return "";
  const date = new Date(iso);
  const monthNames: Record<Locale, string[]> = {
    mk: ["јан", "фев", "мар", "апр", "мај", "јун", "јул", "авг", "сеп", "окт", "ное", "дек"],
    sq: ["jan", "shk", "mar", "pri", "maj", "qer", "kor", "gus", "sht", "tet", "nën", "dhj"],
    en: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
  };
  return `${date.getDate()} ${monthNames[locale][date.getMonth()]} ${date.getFullYear()}`;
}
---

{
  articles.length > 0 && (
    <section class="py-20 md:py-28 bg-background">
      <div class="container-page">
        <div class="flex items-end justify-between gap-6 flex-wrap mb-12">
          <div>
            <h2 class="text-[1.75rem] md:text-[2.25rem] font-bold tracking-tight mb-2 text-foreground">
              {t("home.articles.title", locale)}
            </h2>
            <p class="text-[0.9375rem] text-muted-foreground m-0 max-w-md">
              {t("home.articles.lead", locale)}
            </p>
          </div>
          <TextLink href={`/${locale}/articles`}>
            {t("home.articles.viewAll", locale)} →
          </TextLink>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {articles.map((article) => (
            <a
              href={articleHref(article)}
              class="group block transition-transform duration-200 hover:-translate-y-0.5"
            >
              {article.coverImage && (
                <div class="aspect-16/10 overflow-hidden rounded-md bg-secondary mb-5">
                  <img
                    src={urlFor(article.coverImage)
                      .width(800)
                      .height(500)
                      .quality(80)
                      .format("webp")
                      .url()}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}
              <div class="px-1">
                {article.publishedAt && (
                  <time class="label-caps text-[10px] text-muted-foreground">
                    {formatDate(article.publishedAt)}
                  </time>
                )}
                <h3 class="text-lg font-bold tracking-tight mt-2 mb-2.5 leading-snug text-foreground transition-colors group-hover:text-brand">
                  {pickLocale(article.title, locale)}
                </h3>
                {pickLocale(article.lead, locale) && (
                  <p class="text-[0.9375rem] leading-[1.55] text-muted-foreground mb-4 line-clamp-2">
                    {pickLocale(article.lead, locale)}
                  </p>
                )}
                <span class="text-sm font-medium text-brand">
                  {t("home.articles.readMore", locale)} →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
