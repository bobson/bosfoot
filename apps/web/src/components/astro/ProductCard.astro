---
import Badge from "@/components/astro/Badge.astro";
import Price from "@/components/astro/Price.astro";
import {
  type Locale,
  t,
  pickLocale,
  localePath,
} from "@/lib/i18n";
import { urlFor } from "@/lib/sanity";
import { type ProductCard, productSlug, totalStock } from "@/lib/queries";

interface Props {
  product: ProductCard;
  locale: Locale;
}

const { product, locale } = Astro.props;
const name = pickLocale(product.name, locale) ?? "Unnamed";
const slug = productSlug(product, locale);
const href = localePath(
  locale,
  "products",
  product.brand.slug.current,
  slug,
);
const inStock = totalStock(product) > 0;

const colorHexes = Array.from(
  new Set(
    product.variants
      .map((v) => v.colorHex)
      .filter((hex): hex is string => Boolean(hex)),
  ),
);

const imageUrl = product.mainImage
  ? urlFor(product.mainImage)
      .width(600)
      .height(600)
      .quality(80)
      .format("webp")
      .url()
  : null;

const onSale =
  product.compareAtPrice && product.compareAtPrice > product.price;
---

<a
  href={href}
  data-slot="card"
  class="block group flex flex-col bg-card text-card-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
>
  <!-- Image — square, with NEW/SALE badges and out-of-stock overlay -->
  <div class="relative aspect-square overflow-hidden bg-muted">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={name}
          loading="lazy"
          decoding="async"
          width="600"
          height="600"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-ink-subtle text-xs">
          No image
        </div>
      )
    }

    <div class="absolute top-3 left-3 flex flex-col gap-1.5">
      {product.newArrival && <Badge>{t("product.new", locale)}</Badge>}
      {onSale && <Badge variant="brand">{t("product.sale", locale)}</Badge>}
    </div>

    <!-- Demo notice — every product card carries this until the brand
         publishes real catalog imagery. Placed top-right so it never clashes
         with the NEW/SALE badges on the left. -->
    <span
      class="absolute top-3 right-3 inline-flex items-center px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-sm bg-amber-100 text-amber-900 ring-1 ring-amber-200/60"
      title="Demo product — image and details are for design preview only"
    >
      Demo
    </span>

    {
      !inStock && (
        <div class="absolute inset-0 bg-background/70 flex items-center justify-center">
          <span class="text-sm font-medium text-foreground">
            {t("product.outOfStock", locale)}
          </span>
        </div>
      )
    }
  </div>

  <!-- Text section — generous spacing (the "more spacing" ask) -->
  <div class="pt-5 pb-6 flex flex-col gap-3">
    {
      colorHexes.length > 0 && (
        <div class="flex gap-1.5 items-center min-h-4">
          {colorHexes.slice(0, 6).map((hex) => (
            <span
              class="w-3.5 h-3.5 rounded-full border border-border"
              style={`background:${hex}`}
              aria-hidden="true"
            />
          ))}
          {colorHexes.length > 6 && (
            <span class="text-xs text-muted-foreground">
              +{colorHexes.length - 6}
            </span>
          )}
        </div>
      )
    }

    <div class="flex flex-col gap-1">
      <div class="text-xs text-muted-foreground uppercase tracking-wider">
        {product.brand?.name}
      </div>
      <h3
        class="text-base font-medium leading-snug text-foreground group-hover:text-brand transition-colors"
      >
        {name}
      </h3>
    </div>

    <div class="flex items-start gap-3 text-sm pt-1">
      <Price
        amount={product.price}
        locale={locale}
        align="start"
        primaryClass="font-medium text-foreground"
      />
      {
        onSale && product.compareAtPrice && (
          <Price
            amount={product.compareAtPrice}
            locale={locale}
            align="start"
            class="text-xs"
            primaryClass="text-muted-foreground line-through"
            secondaryClass="line-through"
          />
        )
      }
    </div>
  </div>
</a>
