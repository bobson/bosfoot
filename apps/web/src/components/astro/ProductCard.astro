---
import { type Locale, t, pickLocale, localePath, formatPrice } from '@/lib/i18n'
import { urlFor } from '@/lib/sanity'
import { type ProductCard, productSlug, totalStock } from '@/lib/queries'

interface Props {
  product: ProductCard
  locale: Locale
}

const { product, locale } = Astro.props
const name = pickLocale(product.name, locale) ?? 'Unnamed'
const slug = productSlug(product, locale)
const href = localePath(locale, 'products', slug)
const inStock = totalStock(product) > 0

// Unique color hex values across variants — for the color dot strip under the image
const colorHexes = Array.from(
  new Set(
    product.variants
      .map((v) => v.colorHex)
      .filter((hex): hex is string => Boolean(hex)),
  ),
)

const imageUrl = product.mainImage
  ? urlFor(product.mainImage).width(600).height(600).quality(80).format('webp').url()
  : null

const onSale = product.compareAtPrice && product.compareAtPrice > product.price
---

<a
  href={href}
  class="group block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] rounded-md"
>
  <article class="space-y-3">

    <!-- Image — square aspect ratio with subtle background for transparent product shots -->
    <div class="aspect-square overflow-hidden rounded-md bg-[var(--color-bg-secondary)] relative">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={name}
          loading="lazy"
          decoding="async"
          width="600"
          height="600"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-[var(--color-ink-subtle)] text-xs">
          No image
        </div>
      )}

      <!-- Badges -->
      <div class="absolute top-3 left-3 flex flex-col gap-1.5">
        {product.newArrival && (
          <span class="px-2 py-0.5 bg-[var(--color-ink)] text-[var(--color-bg-primary)] text-[10px] uppercase tracking-wider rounded-sm">
            {t('product.new', locale)}
          </span>
        )}
        {onSale && (
          <span class="px-2 py-0.5 bg-[var(--color-accent)] text-white text-[10px] uppercase tracking-wider rounded-sm">
            {t('product.sale', locale)}
          </span>
        )}
      </div>

      {!inStock && (
        <div class="absolute inset-0 bg-white/70 flex items-center justify-center">
          <span class="text-sm font-medium text-[var(--color-ink)]">
            {t('product.outOfStock', locale)}
          </span>
        </div>
      )}
    </div>

    <!-- Color swatches strip — Vivobarefoot-style -->
    {colorHexes.length > 0 && (
      <div class="flex gap-1.5 items-center min-h-[16px]">
        {colorHexes.slice(0, 6).map((hex) => (
          <span
            class="w-3.5 h-3.5 rounded-full border border-[var(--color-border-default)]"
            style={`background:${hex}`}
            aria-hidden="true"
          ></span>
        ))}
        {colorHexes.length > 6 && (
          <span class="text-xs text-[var(--color-ink-muted)]">+{colorHexes.length - 6}</span>
        )}
      </div>
    )}

    <!-- Brand + name -->
    <div class="space-y-1">
      <div class="text-xs text-[var(--color-ink-muted)] uppercase tracking-wider">
        {product.brand?.name}
      </div>
      <h3 class="text-base font-medium leading-snug group-hover:text-[var(--color-accent)] transition-colors">
        {name}
      </h3>
    </div>

    <!-- Price -->
    <div class="flex items-baseline gap-2 text-sm">
      <span class="font-medium">{formatPrice(product.price, locale)}</span>
      {onSale && product.compareAtPrice && (
        <span class="text-[var(--color-ink-muted)] line-through text-xs">
          {formatPrice(product.compareAtPrice, locale)}
        </span>
      )}
    </div>

  </article>
</a>
