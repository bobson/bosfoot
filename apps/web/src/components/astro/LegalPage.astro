---
import { type Locale, t } from "@/lib/i18n";

interface Section {
  title: string;
  body: string;
}

interface Props {
  locale: Locale;
  title: string;
  lead: string;
  /** Sections rendered as a vertical list with title + body */
  sections: Section[];
  /** Contact email shown at the bottom; falls back to contact@bosfoot.com */
  contactEmail?: string;
  /** Optional "last updated" date (display string) */
  lastUpdated?: string;
}

const {
  locale,
  title,
  lead,
  sections,
  contactEmail = "contact@bosfoot.com",
  lastUpdated,
} = Astro.props;
---

<section class="container-page py-12 md:py-16 max-w-2xl">
  <header class="mb-12 pb-8 border-b border-border-subtle">
    <h1 class="text-3xl md:text-5xl font-semibold tracking-tight mb-4">
      {title}
    </h1>
    <p class="text-[1.0625rem] leading-relaxed text-muted-foreground">{lead}</p>
    {
      lastUpdated && (
        <p class="text-xs text-ink-subtle mt-5 uppercase tracking-wider">
          {t("legal.lastUpdated", locale)}: {lastUpdated}
        </p>
      )
    }
  </header>

  <div class="flex flex-col gap-8">
    {
      sections.map((section) => (
        <section>
          <h2 class="text-xl md:text-[1.4rem] font-semibold tracking-tight mb-2.5">
            {section.title}
          </h2>
          <p class="text-base leading-[1.7] text-muted-foreground">
            {section.body}
          </p>
        </section>
      ))
    }

    <aside
      class="mt-6 px-5 py-4 bg-secondary border-l-[3px] border-border italic text-sm text-ink-subtle rounded-r-md"
    >
      {t("legal.placeholder", locale)}
    </aside>

    <p
      class="mt-8 pt-8 border-t border-border-subtle text-[0.9375rem] text-muted-foreground"
    >
      {t("legal.contactCta", locale)}{" "}
      <a
        href={`mailto:${contactEmail}`}
        class="text-brand hover:text-brand-hover transition-colors"
        >{contactEmail}</a
      >
    </p>
  </div>
</section>
