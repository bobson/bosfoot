---
import { type Locale, t, localePath } from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale } = Astro.props;
const productsPath = localePath(locale, "products");

/**
 * Hero — pure CSS, no images, no JS.
 *
 * Layout: split column on desktop. Left: tagline + lead + 3 CTAs.
 * Right: rotating quote card on a subtle accent background.
 *
 * The card rotates between 3 quotes using CSS keyframes on three stacked
 * absolute-positioned children. Total cycle: 18 seconds (6s per slide).
 *
 * Why no image: shoe photography is hard to license and slow to load.
 * Solid tones + good typography give a premium feel and the page loads
 * in well under a second. We can add a single high-quality product photo
 * later as a subtle background watermark if we want.
 */
---

<section class="hero">
  <div class="container-page hero-inner">
    <!-- Left: tagline + CTAs -->
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-title-line-1">{t("home.hero.line1", locale)}</span>
        <span class="hero-title-line-2">{t("home.hero.line2", locale)}</span>
      </h1>

      <p class="hero-lead">{t("home.hero.lead", locale)}</p>

      <div class="hero-ctas">
        <a
          href={`${productsPath}?gender=mens`}
          class="hero-cta hero-cta-primary"
        >
          {t("home.hero.shopMen", locale)}
        </a>
        <a
          href={`${productsPath}?gender=womens`}
          class="hero-cta hero-cta-primary"
        >
          {t("home.hero.shopWomen", locale)}
        </a>
        <a
          href={`${productsPath}?gender=kids`}
          class="hero-cta hero-cta-secondary"
        >
          {t("home.hero.shopKids", locale)}
        </a>
      </div>
    </div>

    <!-- Right: rotating quote card -->
    <div class="hero-quote-card" aria-hidden="true">
      <div class="quote-slide quote-slide-1">
        <div class="quote-mark">"</div>
        <p class="quote-text">{t("home.quote.1.text", locale)}</p>
        <p class="quote-attr">— {t("home.quote.1.attr", locale)}</p>
      </div>
      <div class="quote-slide quote-slide-2">
        <div class="quote-mark">"</div>
        <p class="quote-text">{t("home.quote.2.text", locale)}</p>
        <p class="quote-attr">— {t("home.quote.2.attr", locale)}</p>
      </div>
      <div class="quote-slide quote-slide-3">
        <div class="quote-mark">"</div>
        <p class="quote-text">{t("home.quote.3.text", locale)}</p>
        <p class="quote-attr">— {t("home.quote.3.attr", locale)}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  /* Subtle decorative line for visual interest, no actual image needed */
  .hero::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -10%;
    width: 120%;
    height: 1px;
    background: var(--color-border-subtle);
    transform: rotate(-3deg);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 6rem 0 7rem;
    }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }
  }

  /* ── Left content ──────────────────────────────────────── */
  .hero-content {
    max-width: 36rem;
  }

  .hero-title {
    font-size: 2.5rem;
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4rem;
    }
  }

  @media (min-width: 1100px) {
    .hero-title {
      font-size: 5rem;
    }
  }

  .hero-title-line-1 {
    display: block;
  }
  .hero-title-line-2 {
    display: block;
    color: var(--color-accent);
    font-style: italic;
    font-weight: 500;
  }

  .hero-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0 0 2.5rem;
    max-width: 28rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: all 150ms ease;
  }

  .hero-cta-primary {
    background: var(--color-ink);
    color: var(--color-bg-primary);
  }
  .hero-cta-primary:hover {
    background: #000;
    transform: translateY(-1px);
  }

  .hero-cta-secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }
  .hero-cta-secondary:hover {
    background: var(--color-ink);
    color: var(--color-bg-primary);
  }

  /* ── Right quote card ──────────────────────────────────── */
  .hero-quote-card {
    position: relative;
    background: var(--color-bg-primary);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    min-height: 280px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero-quote-card {
      padding: 3rem 2.5rem;
      min-height: 320px;
    }
  }

  .quote-slide {
    position: absolute;
    inset: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    opacity: 0;
    animation: quote-rotate 18s infinite;
  }

  @media (min-width: 768px) {
    .quote-slide {
      inset: 3rem 2.5rem;
    }
  }

  /* Each slide takes its 6-second slot in the 18s cycle.
     Stagger by 6s using animation-delay.
     Within the cycle: 0-5% appear, 5-28% visible, 28-33% fade out, then hidden. */
  .quote-slide-1 {
    animation-delay: 0s;
  }
  .quote-slide-2 {
    animation-delay: -12s;
  }
  .quote-slide-3 {
    animation-delay: -6s;
  }

  @keyframes quote-rotate {
    0%,
    2% {
      opacity: 0;
      transform: translateY(8px);
    }
    5%,
    28% {
      opacity: 1;
      transform: translateY(0);
    }
    33%,
    100% {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .quote-mark {
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .quote-text {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-ink);
    font-style: italic;
    margin: 0;
    flex: 1;
  }

  @media (min-width: 768px) {
    .quote-text {
      font-size: 1.15rem;
    }
  }

  .quote-attr {
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Respect prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .quote-slide {
      animation: none;
      opacity: 1;
    }
    .quote-slide:not(:first-child) {
      display: none;
    }
  }
</style>
