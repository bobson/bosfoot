---
import Button from "@/components/astro/Button.astro";
import { type Locale, t, localePath } from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale } = Astro.props;
const productsPath = localePath(locale, "products");
---

<section class="hero-section relative overflow-hidden bg-stone-900">
  <!-- Responsive image: small for mobile, large for tablet+ -->
  <picture>
    <source
      media="(min-width: 768px)"
      srcset="/images/hero/hero-large.webp"
      type="image/webp"
    />
    <img
      src="/images/hero/hero-small.webp"
      alt="Freet barefoot shoes and boots"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-top"
    />
  </picture>

  <!-- Bottom-left gradient for text legibility -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>

  <!-- Text + CTAs — bottom left -->
  <div class="container-page relative h-full flex items-end pb-10 md:pb-14">
    <div class="max-w-sm md:max-w-md">
      <h1 class="text-[1.6rem] md:text-[2rem] font-semibold leading-[1.2] tracking-tight text-white mb-6">
        {t("home.hero.line1", locale)}{" "}
        <span class="italic font-normal">{t("home.hero.line2", locale)}</span>
      </h1>

      <div class="flex gap-3">
        <Button
          href={productsPath}
          variant="brand"
          size="sm"
          class="hover:bg-primary hover:text-primary-foreground active:bg-primary active:text-primary-foreground hover:translate-y-0"
        >
          {t("cta.shopNow", locale)}
        </Button>
        <Button
          href={`${productsPath}?gender=kids`}
          variant="outline"
          size="sm"
          class="!border-white !text-white hover:!bg-white hover:!text-foreground"
        >
          {t("home.hero.shopKids", locale)}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 520px;
    height: 62svh;
    max-height: 780px;
  }
  @media (min-width: 768px) {
    .hero-section {
      min-height: 580px;
      height: 68svh;
    }
  }
</style>
