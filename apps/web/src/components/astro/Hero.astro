---
import Card from "@/components/astro/Card.astro";
import Button from "@/components/astro/Button.astro";
import { type Locale, t, localePath } from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";

interface Props {
  locale: Locale;
  siteSettings: SiteSettings | null;
}

const { locale } = Astro.props;
const productsPath = localePath(locale, "products");

/**
 * Hero — pure CSS, no images, no JS.
 *
 * Layout: split column on desktop. Left: tagline + lead + 3 CTAs.
 * Right: rotating quote card (shadcn Card) over a subtle muted backdrop.
 *
 * The card rotates between 3 quotes using CSS keyframes on three stacked
 * absolute-positioned children. Total cycle: 18s (6s per slide). Respects
 * prefers-reduced-motion.
 */
---

<section
  class="relative overflow-hidden bg-secondary border-b border-border py-16 md:py-24"
>
  <!-- Subtle decorative line for visual interest, no image needed -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 -left-[10%] w-[120%] h-px bg-border opacity-50"
    style="transform: rotate(-3deg)"
  >
  </div>

  <div
    class="container-page relative grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] items-center gap-12 lg:gap-16"
  >
    <!-- Left: tagline + CTAs -->
    <div class="max-w-2xl">
      <h1
        class="font-semibold leading-[1.05] tracking-tight text-foreground text-[2.5rem] md:text-6xl xl:text-[5rem] mb-6"
      >
        <span class="block">{t("home.hero.line1", locale)}</span>
        <span class="block text-brand italic font-medium">
          {t("home.hero.line2", locale)}
        </span>
      </h1>

      <p
        class="text-[1.05rem] leading-relaxed text-muted-foreground mb-10 max-w-md"
      >
        {t("home.hero.lead", locale)}
      </p>

      <div class="flex flex-wrap gap-3">
        <Button href={`${productsPath}?gender=mens`} size="lg">
          {t("home.hero.shopMen", locale)}
        </Button>
        <Button href={`${productsPath}?gender=womens`} size="lg">
          {t("home.hero.shopWomen", locale)}
        </Button>
        <Button href={`${productsPath}?gender=kids`} variant="outline" size="lg">
          {t("home.hero.shopKids", locale)}
        </Button>
      </div>
    </div>

    <!-- Right: rotating quote card -->
    <Card class="relative min-h-[280px] md:min-h-[320px] p-10 md:p-12 shadow-sm">
      <div class="hero-quote-slide hero-quote-slide-1 absolute inset-10 md:inset-12 flex flex-col">
        <div class="font-serif text-7xl leading-none text-brand font-bold mb-2">"</div>
        <p class="text-[1.05rem] md:text-[1.15rem] leading-[1.55] italic text-foreground m-0 flex-1">
          {t("home.quote.1.text", locale)}
        </p>
        <p class="mt-5 text-[0.8125rem] text-muted-foreground font-medium uppercase tracking-widest">
          — {t("home.quote.1.attr", locale)}
        </p>
      </div>

      <div class="hero-quote-slide hero-quote-slide-2 absolute inset-10 md:inset-12 flex flex-col">
        <div class="font-serif text-7xl leading-none text-brand font-bold mb-2">"</div>
        <p class="text-[1.05rem] md:text-[1.15rem] leading-[1.55] italic text-foreground m-0 flex-1">
          {t("home.quote.2.text", locale)}
        </p>
        <p class="mt-5 text-[0.8125rem] text-muted-foreground font-medium uppercase tracking-widest">
          — {t("home.quote.2.attr", locale)}
        </p>
      </div>

      <div class="hero-quote-slide hero-quote-slide-3 absolute inset-10 md:inset-12 flex flex-col">
        <div class="font-serif text-7xl leading-none text-brand font-bold mb-2">"</div>
        <p class="text-[1.05rem] md:text-[1.15rem] leading-[1.55] italic text-foreground m-0 flex-1">
          {t("home.quote.3.text", locale)}
        </p>
        <p class="mt-5 text-[0.8125rem] text-muted-foreground font-medium uppercase tracking-widest">
          — {t("home.quote.3.attr", locale)}
        </p>
      </div>
    </Card>
  </div>
</section>

<style>
  /* 18s rotation keyframe — CSS-only, no JS. Kept in <style> because
     scoped `animation-delay` on three siblings is awkward in pure Tailwind. */
  .hero-quote-slide {
    opacity: 0;
    animation: hero-quote-rotate 18s infinite;
  }
  .hero-quote-slide-1 { animation-delay: 0s; }
  .hero-quote-slide-2 { animation-delay: -12s; }
  .hero-quote-slide-3 { animation-delay: -6s; }

  @keyframes hero-quote-rotate {
    0%, 2% { opacity: 0; transform: translateY(8px); }
    5%, 28% { opacity: 1; transform: translateY(0); }
    33%, 100% { opacity: 0; transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-quote-slide { animation: none; opacity: 1; }
    .hero-quote-slide:not(:first-child) { display: none; }
  }
</style>
