---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import CartDrawer from "@/components/react/CartDrawer.tsx";
import ChatWidget from "@/components/react/ChatWidget.tsx";
import SpeedInsights from "@vercel/speed-insights/astro";
import { type Locale, t, pickLocale } from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";
import { organizationLD, websiteLD } from "@/lib/structured-data";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  siteSettings: SiteSettings | null;
  ogImage?: string;
  /** Additional JSON-LD schemas to inject (Product, Article, Breadcrumb). */
  structuredData?: Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  siteSettings,
  ogImage,
  structuredData = [],
} = Astro.props;

const langAttr = locale === "mk" ? "mk" : locale === "sq" ? "sq" : "en";
const fullTitle =
  title === siteSettings?.siteName
    ? title
    : `${title} — ${siteSettings?.siteName ?? "Bosfoot"}`;
const fallbackDescription = pickLocale(siteSettings?.tagline, locale);
const metaDescription = description ?? fallbackDescription ?? "";

// Always include Organization + WebSite; pages can pass extra schemas via prop.
const siteUrl = Astro.site ?? "https://bosfoot.com";
const allSchemas = [
  organizationLD({ siteUrl, siteSettings }),
  websiteLD({ siteUrl, siteSettings, locale }),
  ...structuredData,
];
---

<!doctype html>
<html lang={langAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    {
      metaDescription && (
        <meta property="og:description" content={metaDescription} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Early connection to Sanity CDN so image fetches skip the TCP/TLS
         handshake cost. -->
    <link rel="preconnect" href="https://cdn.sanity.io" />

    <!-- IBM Plex Sans is self-hosted via @font-face in global.css. Preload
         the Latin subset (loaded on every page in every locale — Cyrillic
         and Latin-Ext load lazily only on pages that need them). -->
    <link
      rel="preload"
      href="/fonts/plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512.png" />

    <!-- SPA-style navigation: patches the DOM in place instead of full reloads,
         so stylesheets and the already-loaded variable font persist across
         navigations (no font swap / nav-link reflow per page change). -->
    <ClientRouter />

    <!-- JSON-LD structured data: Organization + WebSite are always present;
         pages may add Product/Article/BreadcrumbList via the `structuredData` prop. -->
    {
      allSchemas.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <!-- Pages can inject preload links and other head elements here. -->
    <slot name="head" />
  </head>
  <body>
    {/* Top navigation progress bar. Hooks into Astro's ClientRouter lifecycle
        and only appears if the next page takes longer than 300ms to swap, so
        fast cached navigations don't flash a sliver. */}
    <div
      id="nav-progress"
      class="fixed top-0 left-0 right-0 h-[2px] bg-brand z-[60] origin-left pointer-events-none"
      style="transform: scaleX(0); opacity: 0;"
      aria-hidden="true"
    ></div>

    {
      siteSettings?.announcement?.enabled && siteSettings.announcement.text && (
        <div
          class="bg-ink text-bg-primary text-center text-sm py-2 px-4"
          role="region"
          aria-label="Announcement"
        >
          {siteSettings.announcement.link ? (
            <a href={siteSettings.announcement.link}>
              {pickLocale(siteSettings.announcement.text, locale)}
            </a>
          ) : (
            <span>{pickLocale(siteSettings.announcement.text, locale)}</span>
          )}
        </div>
      )
    }

    <Header locale={locale} siteSettings={siteSettings} />

    <main>
      <slot />
    </main>

    <Footer locale={locale} siteSettings={siteSettings} />

    <!-- Cart drawer — fixed position, available everywhere; opens on cart events.
         transition:persist keeps the React island mounted across navigations so
         the drawer doesn't unmount if it's open during a nav. -->
    <CartDrawer locale={locale} client:load transition:persist />

    <!-- Floating chat agent — Claude Haiku 4.5-backed customer support widget.
         Loaded idle so it never competes with critical-path JS. -->
    <ChatWidget client:idle transition:persist />

    <SpeedInsights />

    {/* Nav progress bar lifecycle. Listeners bind once and survive across
        ClientRouter swaps because the script lives in <body> and the swap
        replaces inner content, not document-level event handlers. */}
    <script>
      const SHOW_DELAY_MS = 300;
      let showTimer: number | null = null;
      let fadeTimer1: number | null = null;
      let fadeTimer2: number | null = null;
      let visible = false;

      const bar = () => document.getElementById("nav-progress");

      const apply = (
        el: HTMLElement,
        scaleX: number,
        opacity: number,
        durationMs: number,
      ) => {
        el.style.transition =
          durationMs === 0
            ? "none"
            : `transform ${durationMs}ms ease-out, opacity ${durationMs}ms ease-out`;
        el.style.transform = `scaleX(${scaleX})`;
        el.style.opacity = String(opacity);
      };

      const start = () => {
        const el = bar();
        if (!el) return;
        if (fadeTimer1 !== null) clearTimeout(fadeTimer1);
        if (fadeTimer2 !== null) clearTimeout(fadeTimer2);
        fadeTimer1 = fadeTimer2 = null;
        apply(el, 0, 0, 0);
        visible = false;
        showTimer = window.setTimeout(() => {
          const e = bar();
          if (!e) return;
          apply(e, 0.7, 1, 400);
          visible = true;
        }, SHOW_DELAY_MS);
      };

      const finish = () => {
        if (showTimer !== null) {
          clearTimeout(showTimer);
          showTimer = null;
        }
        const el = bar();
        if (!el) return;
        if (!visible) {
          apply(el, 0, 0, 0);
          return;
        }
        apply(el, 1, 1, 150);
        fadeTimer1 = window.setTimeout(() => {
          const e = bar();
          if (!e) return;
          apply(e, 1, 0, 250);
          fadeTimer2 = window.setTimeout(() => {
            const e2 = bar();
            if (!e2) return;
            apply(e2, 0, 0, 0);
            visible = false;
          }, 260);
        }, 160);
      };

      document.addEventListener("astro:before-preparation", start);
      document.addEventListener("astro:after-swap", finish);
    </script>
  </body>
</html>

<style is:global>
  /* Quick utility additions Tailwind doesn't cover by default in v4 */
  .bg-ink {
    background: var(--color-ink);
  }
  .text-bg-primary {
    color: var(--color-bg-primary);
  }
</style>
