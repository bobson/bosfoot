---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import CartDrawer from "@/components/react/CartDrawer.tsx";
import ChatWidget from "@/components/react/ChatWidget.tsx";
import SpeedInsights from "@vercel/speed-insights/astro";
import { type Locale, LOCALES, t, pickLocale, switchLocale } from "@/lib/i18n";
import type { SiteSettings } from "@/lib/queries";
import { organizationLD, websiteLD } from "@/lib/structured-data";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  siteSettings: SiteSettings | null;
  ogImage?: string;
  /** Additional JSON-LD schemas to inject (Product, Article, Breadcrumb). */
  structuredData?: Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  siteSettings,
  ogImage,
  structuredData = [],
} = Astro.props;

const langAttr = locale === "mk" ? "mk" : locale === "sq" ? "sq" : "en";
const fullTitle =
  title === siteSettings?.siteName
    ? title
    : `${title} — ${siteSettings?.siteName ?? "Bosfoot"}`;
const fallbackDescription = pickLocale(siteSettings?.tagline, locale);
const metaDescription = description ?? fallbackDescription ?? "";

// Always include Organization + WebSite; pages can pass extra schemas via prop.
const siteUrl = (Astro.site ?? "https://bosfoot.com").toString().replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const allSchemas = [
  organizationLD({ siteUrl, siteSettings }),
  websiteLD({ siteUrl, siteSettings, locale }),
  ...structuredData,
];
---

<!doctype html>
<html lang={langAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    {
      metaDescription && (
        <meta property="og:description" content={metaDescription} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Self-referential canonical: tells Google which URL is preferred for this
         locale variant. Combined with hreflang below, each locale gets indexed
         independently rather than collapsed as "duplicate without canonical". -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- hreflang: tell Google which locale serves which language.
         x-default points to mk (the primary market). -->
    {LOCALES.map((lang) => (
      <link
        rel="alternate"
        hreflang={lang}
        href={`${siteUrl}${switchLocale(currentPath, lang)}`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${siteUrl}${switchLocale(currentPath, "mk")}`}
    />

    <!-- Early connection to Sanity CDN so image fetches skip the TCP/TLS
         handshake cost. -->
    <link rel="preconnect" href="https://cdn.sanity.io" />

    <!-- IBM Plex Sans is self-hosted via @font-face in global.css. Preload
         the Latin subset (loaded on every page in every locale — Cyrillic
         and Latin-Ext load lazily only on pages that need them). -->
    <link
      rel="preload"
      href="/fonts/plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512.png" />

    <ClientRouter />

    <!-- JSON-LD structured data: Organization + WebSite are always present;
         pages may add Product/Article/BreadcrumbList via the `structuredData` prop. -->
    {
      allSchemas.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <!-- Pages can inject preload links and other head elements here. -->
    <slot name="head" />
  </head>
  <body>
    <!-- Page-load progress bar (indeterminate shimmer while loading, snaps to done) -->
    <div id="page-progress" aria-hidden="true" style="position:fixed;top:0;left:0;height:2px;z-index:9999;pointer-events:none;opacity:0;width:100%">
      <div id="page-progress-inner" style="height:100%;background:var(--color-brand);width:30%;border-radius:0 2px 2px 0"></div>
    </div>
    <script>
      (() => {
        const wrap  = document.getElementById("page-progress") as HTMLElement;
        const inner = document.getElementById("page-progress-inner") as HTMLElement;
        let anim: Animation | null = null;
        let finish: ReturnType<typeof setTimeout>;
        let hide: ReturnType<typeof setTimeout>;

        const start = () => {
          clearTimeout(finish);
          clearTimeout(hide);
          // Reset without transition, then show.
          inner.style.transition = "none";
          inner.style.width = "30%";
          wrap.style.opacity = "1";
          // Bounce the inner bar back and forth — always moving, speed-agnostic.
          anim?.cancel();
          anim = inner.animate(
            [
              { marginLeft: "0%",   width: "30%" },
              { marginLeft: "70%",  width: "30%" },
              { marginLeft: "0%",   width: "30%" },
            ],
            { duration: 1200, iterations: Infinity, easing: "ease-in-out" }
          );
        };

        const done = () => {
          anim?.cancel();
          anim = null;
          // Snap the bar to full width, then fade out.
          inner.style.transition = "none";
          inner.style.marginLeft = "0%";
          inner.style.width = "100%";
          finish = setTimeout(() => {
            wrap.style.transition = "opacity .3s ease";
            wrap.style.opacity = "0";
            hide = setTimeout(() => {
              wrap.style.transition = "";
              inner.style.width = "30%";
            }, 320);
          }, 150);
        };

        document.addEventListener("astro:before-preparation", start);
        document.addEventListener("astro:page-load", done);
      })();
    </script>

    {
      siteSettings?.announcement?.enabled && siteSettings.announcement.text && (
        <div
          class="bg-ink text-bg-primary text-center text-sm py-2 px-4"
          role="region"
          aria-label="Announcement"
        >
          {siteSettings.announcement.link ? (
            <a href={siteSettings.announcement.link}>
              {pickLocale(siteSettings.announcement.text, locale)}
            </a>
          ) : (
            <span>{pickLocale(siteSettings.announcement.text, locale)}</span>
          )}
        </div>
      )
    }

    <Header locale={locale} siteSettings={siteSettings} />

    <main>
      <slot />
    </main>

    <Footer locale={locale} siteSettings={siteSettings} />

    <!-- Cart drawer — persisted so it stays mounted and open across navigations. -->
    <CartDrawer locale={locale} client:idle transition:persist />

    <!-- Floating chat agent — persisted so conversation state survives navigation. -->
    <ChatWidget client:idle transition:persist />

    <SpeedInsights />
  </body>
</html>

<style is:global>
  /* Quick utility additions Tailwind doesn't cover by default in v4 */
  .bg-ink {
    background: var(--color-ink);
  }
  .text-bg-primary {
    color: var(--color-bg-primary);
  }
</style>
