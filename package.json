{
  "name": "bosfoot",
  "version": "0.0.1",
  "private": true,
  "description": "Bosfoot — barefoot shoes for the Western Balkans",
  "scripts": {
    "studio": "pnpm --filter studio dev",
    "studio:build": "pnpm --filter studio build",
    "studio:deploy": "pnpm --filter studio deploy",
    "web": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "catalog": "pnpm --filter scripts catalog",
    "catalog:apply": "pnpm --filter scripts catalog:apply",
    "articles": "pnpm --filter scripts articles",
    "articles:apply": "pnpm --filter scripts articles:apply"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.12.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
